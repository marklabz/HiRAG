  <data key="d4">8.0</data>
  <data key="d5">"Depository account balances are factored into the housing expense calculation for mortgage approvals."</data>
  <data key="d6">chunk-2eef4940eec1ef97062f77d3efe4074e</data>
  <data key="d7">1</data>
</edge>
