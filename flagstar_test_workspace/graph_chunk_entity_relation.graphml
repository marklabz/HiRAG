  <data key="d6">chunk-843cd03316121e01909837126fbbe24c</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;ELIGIBLE LOAN PURPOSE&quot;" target="&quot;MORTGAGE PREMISES&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The mortgage premises must align with the eligible loan purpose for the loan to be valid."</data>
  <data key="d6">chunk-0610be8f2c48d2ab9263a9d9aea08a29</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;ELIGIBLE LOAN PURPOSE&quot;" target="&quot;UNDERWRITING GUIDELINES&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"Underwriting guidelines dictate the eligible loan purposes that a borrower can apply for."</data>
  <data key="d6">chunk-0610be8f2c48d2ab9263a9d9aea08a29</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;GROSSING UP INCOME&quot;" target="&quot;TAX-FREE INCOME&quot;">
  <data key="d4">6.0</data>
  <data key="d5">"Tax-free income, such as from housing allowances, can be grossed up for qualifying income under certain conditions."</data>
  <data key="d6">chunk-0610be8f2c48d2ab9263a9d9aea08a29</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;GROSSING UP INCOME&quot;" target="&quot;EMPLOYMENT OFFER&quot;">
  <data key="d4">6.0</data>
  <data key="d5">"The grossing up of income can include figures stated in employment offers under the qualifying income standards."</data>
  <data key="d6">chunk-0610be8f2c48d2ab9263a9d9aea08a29</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;MORTGAGE PREMISES&quot;" target="&quot;PRIMARY EMPLOYMENT&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"Primary employment income is used to determine eligibility for mortgages concerning the mortgaged premises."</data>
  <data key="d6">chunk-0610be8f2c48d2ab9263a9d9aea08a29</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;MORTGAGE PREMISES&quot;" target="&quot;BORROWER'S DEPOSITORY&quot;">
  <data key="d4">7.0</data>
