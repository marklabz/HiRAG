  <data key="d6">chunk-3f01d27887cb1edc56efdd9355e2cbba</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;UNDERWRITER&quot;" target="&quot;VERIFICATION OF EMPLOYMENT&quot;">
  <data key="d4">18.0</data>
  <data key="d5">"The UNDERWRITER performs the VERIFICATION OF EMPLOYMENT to confirm the Borrower's employment status before approving the mortgage."&lt;SEP&gt;"The underwriter is responsible for verifying the Borrower's employment and income documentation."</data>
  <data key="d6">chunk-909c805f10bec3b9745cd64c1852b1fd&lt;SEP&gt;chunk-3f01d27887cb1edc56efdd9355e2cbba</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;UNDERWRITER&quot;" target="&quot;LOAN PURPOSE&quot;">
  <data key="d4">8.0</data>
