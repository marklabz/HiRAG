  <data key="d7">1</data>
</edge>
<edge source="&quot;BORROWER&quot;" target="&quot;LIEN RELEASE DATE&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"Lien Release Date is significant for the borrower as it determines the timeline over which debts must be resolved before securing new financing."</data>
