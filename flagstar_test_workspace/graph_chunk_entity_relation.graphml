</edge>
<edge source="&quot;BORROWERS&quot;" target="&quot;CLOSING COSTS&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"Borrowers need to account for closing costs when obtaining financing, often using savings and matched funds."</data>
  <data key="d6">chunk-23ec06f9f4a15f1cb40e52e628766be9</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;BORROWERS&quot;" target="&quot;DOCUMENTATION REQUIREMENTS&quot;">
