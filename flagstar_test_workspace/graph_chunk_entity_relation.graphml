  <data key="d4">8.0</data>
  <data key="d5">"Underwriting guidelines set specific rules regarding acceptable loan purposes and conditions for properties with rental income."</data>
  <data key="d6">chunk-6b454650a6e8dde5a93325db30813c30</data>
