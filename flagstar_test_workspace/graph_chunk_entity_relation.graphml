  <data key="d4">8.0</data>
  <data key="d5">"FLAGSTAR's underwriting process is governed by CONVENTIONAL UNDERWRITING GUIDELINES for loans underwritten by them."</data>
  <data key="d6">chunk-faa30e2538a6e107a9cdb96ee1067084</data>
  <data key="d7">1</data>
</edge>
