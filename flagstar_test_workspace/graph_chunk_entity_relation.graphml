  <data key="d4">6.0</data>
  <data key="d5">"Age-related deed restrictions may also be applicable specifically to one-unit properties, influencing occupancy requirements."</data>
  <data key="d6">chunk-8cfec8ddeaba989b347c8cc9daa583b4</data>
  <data key="d7">1</data>
</edge>
