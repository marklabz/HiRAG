  <data key="d6">chunk-1b8e57f220eeefd0215ac958c381bc47</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;IRS&quot;" target="&quot;CUSTOMER SERVICE&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"IRS CUSTOMER SERVICE can assist taxpayers with issues regarding their tax transcripts."</data>
  <data key="d6">chunk-1b8e57f220eeefd0215ac958c381bc47</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;IRS&quot;" target="&quot;TAX ACCOUNTS&quot;">
  <data key="d4">8.0</data>
