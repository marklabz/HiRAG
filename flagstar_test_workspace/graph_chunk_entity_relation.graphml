  <data key="d4">9.0</data>
  <data key="d5">"CASH FLOW is assessed from the calculations of NET RENTAL INCOME and related expenses outlined in the financial documentation."</data>
  <data key="d6">chunk-fb02bde5abfff1b16d83434416df7465</data>
  <data key="d7">1</data>
</edge>
