  <data key="d4">9.0</data>
  <data key="d5">"The borrower must occupy the property for it to be classified as an owner-occupied transaction."</data>
  <data key="d6">chunk-d0ff713c7eebcf293485e860ba8cc6a1</data>
  <data key="d7">1</data>
</edge>
