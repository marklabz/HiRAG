  <data key="d6">chunk-d9d7483a0c4012d30e50767206255bda</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;FINANCIAL ASSETS&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"Loans secured against financial assets like 401K or IRA are not part of the borrower's recurring monthly debt liabilities."</data>
  <data key="d6">chunk-455b5668460db6760959b99f4a51a667</data>
  <data key="d7">1</data>
</edge>
