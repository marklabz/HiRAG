  <data key="d6">chunk-d8864c52069485823a39babaa2b2005e</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;TAXABLE AMOUNTS&quot;" target="&quot;NON-TAXABLE AMOUNTS&quot;">
  <data key="d4">7.0</data>
