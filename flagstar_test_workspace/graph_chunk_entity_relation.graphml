  <data key="d6">chunk-cea98d6086733276bdd5c19993c4deb7</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;SCHEDULE E&quot;" target="&quot;OPERATING AND MAINTENANCE COSTS&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"Operating and maintenance costs are factors considered in the net rental income calculations outlined in Schedule E."</data>
  <data key="d6">chunk-cea98d6086733276bdd5c19993c4deb7</data>
  <data key="d7">1</data>
</edge>
