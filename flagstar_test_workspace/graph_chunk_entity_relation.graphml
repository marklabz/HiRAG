  <data key="d6">chunk-756642bc27ab7956732455451eb4ce71</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;LEASEHOLD&quot;" target="&quot;FANNIE MAE&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"Fannie Mae has specific Leasehold requirements that ensure the mortgage must be secured by the leasehold interest in the land."</data>
  <data key="d6">chunk-cefb0ad4148eab93b794bfdc3eb3eac7</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;LEASEHOLD&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"Leaseholds require the borrower's leasehold interest to be insured, which directly impacts the borrower’s mortgage conditions."</data>
  <data key="d6">chunk-cefb0ad4148eab93b794bfdc3eb3eac7</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;LEASEHOLD&quot;" target="&quot;MORTGAGE LIEN&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"The mortgage lien must be applied to the leasehold, ensuring protective measures are in place for lenders."</data>
  <data key="d6">chunk-cefb0ad4148eab93b794bfdc3eb3eac7</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;INELIGIBLE PROPERTIES&quot;" target="&quot;ACCESSORY UNIT&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"Properties with more than one accessory unit are classified as ineligible, according to lending requirements."</data>
  <data key="d6">chunk-cefb0ad4148eab93b794bfdc3eb3eac7</data>
  <data key="d7">1</data>
</edge>
