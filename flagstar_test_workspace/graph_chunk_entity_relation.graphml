</node>
<node id="&quot;UNEXPECTED EXPENSES&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Unexpected Expenses refer to unforeseen costs encountered by landlords that can impact rental income and financial assessments."</data>
  <data key="d2">chunk-7a01c4d224477788cf5c6bfd6ccc84e2</data>
  <data key="d3">[{"level": 0, "cluster": 7}, {"level": 1, "cluster": 118}, {"level": 2, "cluster": 362}]</data>
