  <data key="d4">8.0</data>
  <data key="d5">"ADJUSTMENTS FOR BELOW-GRADE AREAS are necessary in the SALES COMPARISON APPROACH for accurate property valuation."</data>
  <data key="d6">chunk-c1eb0558635c4f1b731b5f38c1ed9bb7</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;SALES COMPARISON APPROACH&quot;" target="&quot;COMPARABLE SALES DATA&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"COMPARABLE SALES DATA is an essential component used in the sales comparison approach to determine property value."</data>
  <data key="d6">chunk-bd684789b748cb20186f7859db539838</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;ADJUSTMENTS FOR BELOW-GRADE AREAS&quot;" target="&quot;BASEMENT &amp; FINISHED ROOMS BELOW-GRADE LINE&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"BASEMENT &amp; FINISHED ROOMS BELOW-GRADE LINE are used for making ADJUSTMENTS FOR BELOW-GRADE AREAS in the appraisals."</data>
  <data key="d6">chunk-c1eb0558635c4f1b731b5f38c1ed9bb7</data>
  <data key="d7">1</data>
</edge>
