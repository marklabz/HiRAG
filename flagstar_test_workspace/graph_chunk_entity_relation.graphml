  <data key="d4">9.0</data>
  <data key="d5">"Outstanding loan balances are calculated based on amortizing payments, impacting borrower obligations."</data>
  <data key="d6">chunk-1a05e768a9b64dd897dab3f97a6c234a</data>
  <data key="d7">1</data>
</edge>
