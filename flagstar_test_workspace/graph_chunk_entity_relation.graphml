  <data key="d3">[{"level": 0, "cluster": 1}, {"level": 1, "cluster": 48}]</data>
</node>
<node id="&quot;UNDISCLOSED SELLER CONTRIBUTIONS&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Undisclosed Seller Contributions are payments made on behalf of borrowers by sellers, which can affect loan calculations and borrower obligations."&lt;SEP&gt;"Undisclosed seller contributions are financial aids not mentioned in the official documentation that can impact the sale price and the mortgage's LTV ratio."</data>
  <data key="d2">chunk-c315a6b793aa073b8f6cb2ffb42e4f97&lt;SEP&gt;chunk-05495faf7d0cd92781a907bc384d2f21</data>
