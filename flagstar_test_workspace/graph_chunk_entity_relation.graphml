  <data key="d6">chunk-d9f00ed91955a5d8af076ae0a21e6a69</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;VISA&quot;" target="&quot;INTERNATIONAL REPRESENTATIVES&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"International Representatives often enter the U.S. under specific visa classifications that allow them to perform their duties."</data>
