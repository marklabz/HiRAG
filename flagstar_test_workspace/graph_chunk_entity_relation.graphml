  <data key="d4">8.0</data>
  <data key="d5">"Penalties may apply if the lump-sum distribution is misused or accessed improperly, establishing a direct connection between them."</data>
  <data key="d6">chunk-f67964fc288da88f7bb3defef1f29177</data>
  <data key="d7">1</data>
</edge>
