<node id="&quot;CREDIT DATA&quot;">
  <data key="d0">"NORMAL_ENTITY"</data>
  <data key="d1">"Credit Data comprises all information related to an individual's credit history, including accounts, payment behavior, and inquiries, used in the loan approval process."</data>
  <data key="d2">chunk-0f359b1edc6f123eca67b08265c9b89e</data>
