</edge>
<edge source="&quot;MORTGAGE MARKET&quot;" target="&quot;UNDERWRITING GUIDELINES&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"Underwriting guidelines are critical in defining lending practices within the mortgage market, influencing approval criteria for potential borrowers."</data>
  <data key="d6">chunk-398938dbff78b05d0c3830d36e6918b6</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;INCOME DISTRIBUTIONS&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"INCOME DISTRIBUTIONS from partnerships or LLCs are significant for the BORROWER's cash flow evaluation and loan eligibility."</data>
  <data key="d6">chunk-27c5b5517eef234cf0db585936ec28f7</data>
  <data key="d7">1</data>
</edge>
