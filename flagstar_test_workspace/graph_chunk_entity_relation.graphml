  <data key="d6">chunk-f67964fc288da88f7bb3defef1f29177</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;RETIREMENT ASSETS&quot;" target="&quot;PENALTIES&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"Penalties may apply to the early distribution of retirement assets, indicating a connection between them."</data>
  <data key="d6">chunk-f67964fc288da88f7bb3defef1f29177</data>
  <data key="d7">1</data>
</edge>
