</edge>
<edge source="&quot;BORROWERS&quot;" target="&quot;SERVICING THE LOAN&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"BORROWERS require loan servicing to manage their mortgage payments and obligations."</data>
  <data key="d6">chunk-1a05e768a9b64dd897dab3f97a6c234a</data>
