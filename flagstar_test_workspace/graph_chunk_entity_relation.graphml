  <data key="d5">"The cash flow analysis is performed through the data obtained from FORM 1007 to assess the borrower’s rental income viability."</data>
  <data key="d6">chunk-d8864c52069485823a39babaa2b2005e</data>
  <data key="d7">1</data>
</edge>
