  <data key="d6">chunk-79943296a1fa68394820a29e269db689</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;TAX RETURN&quot;" target="&quot;SCHEDULE C&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"SCHEDULE C provides detailed information about self-employment income and is critical for tax return submissions in loan processing."</data>
  <data key="d6">chunk-79943296a1fa68394820a29e269db689</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;TAX RETURN&quot;" target="&quot;W2 WAGE EARNER&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"W2 wage earners must also provide tax returns as part of the income documentation required for loans."</data>
  <data key="d6">chunk-79943296a1fa68394820a29e269db689</data>
