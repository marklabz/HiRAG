</edge>
<edge source="&quot;BORROWERS&quot;" target="&quot;BORROWER(S) AGE&quot;">
  <data key="d4">6.0</data>
  <data key="d5">"The age of borrowers is a factor in determining loan eligibility, as they must be of legal age for enforcement."</data>
  <data key="d6">chunk-1a05e768a9b64dd897dab3f97a6c234a</data>
  <data key="d7">1</data>
</edge>
