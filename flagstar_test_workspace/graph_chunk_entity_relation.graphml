  <data key="d4">8.0</data>
  <data key="d5">"RENTAL INCOME may be categorized under ALLOWABLE QUALIFYING INCOME when determining the BORROWER's financial status."</data>
  <data key="d6">chunk-fb02bde5abfff1b16d83434416df7465</data>
  <data key="d7">1</data>
</edge>
