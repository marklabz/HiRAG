  <data key="d4">9.0</data>
  <data key="d5">"Stable income sources provide assurance regarding the consistency and predictability of a borrower's income stability."</data>
  <data key="d6">chunk-d1ab9735c2b386c1cf372b9ba4a34fe4</data>
  <data key="d7">1</data>
</edge>
