  <data key="d7">1</data>
</edge>
<edge source="&quot;BORROWER&quot;" target="&quot;BUDGET IN EXPLANATION&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"Budget in Explanation showcases the borrower's transparent financial layout to lenders, outlining the allocation of funds necessary to meet obligations."</data>
