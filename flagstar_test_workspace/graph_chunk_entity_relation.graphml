<node id="&quot;LOAN POLICIES&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Loan Policies are the guidelines established by lenders, including requirements and conditions under which loans are granted and serviced."</data>
  <data key="d2">chunk-46cceddf672b67421d8f87a3665f1ddf</data>
  <data key="d3">[{"level": 0, "cluster": 23}, {"level": 1, "cluster": 200}, {"level": 2, "cluster": 485}]</data>
