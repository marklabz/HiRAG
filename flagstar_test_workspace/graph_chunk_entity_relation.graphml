  <data key="d4">7.0</data>
  <data key="d5">"Income limits for borrowers are particularly relevant for those seeking HomeReady mortgage loans, which may have more restrictive criteria."</data>
  <data key="d6">chunk-8cfec8ddeaba989b347c8cc9daa583b4</data>
  <data key="d7">1</data>
</edge>
