  <data key="d4">7.0</data>
  <data key="d5">"Financing closing costs in relation to the payment of non-delinquent real estate taxes establishes a financial relationship."</data>
  <data key="d6">chunk-9da80c7f63e32b0d7dc6df2ae9032546</data>
  <data key="d7">1</data>
</edge>
