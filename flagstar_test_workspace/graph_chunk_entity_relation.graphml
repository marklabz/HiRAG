  <data key="d1">"Credit Overlays are additional requirements or stipulations lenders may impose beyond the standard guidelines for mortgage loans."</data>
  <data key="d2">chunk-d10b21d56993c3c6bc0aa80dd4168911</data>
  <data key="d3">[{"level": 0, "cluster": 5}, {"level": 1, "cluster": 108}, {"level": 2, "cluster": 354}]</data>
