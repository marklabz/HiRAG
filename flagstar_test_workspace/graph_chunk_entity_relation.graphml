  <data key="d6">chunk-909c805f10bec3b9745cd64c1852b1fd</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;EMPLOYMENT CONTRACT&quot;" target="&quot;REDUCTION IN RESERVES&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"The Employment Contract outlines terms that influence the assessment of Reduction in Reserves for the borrower."</data>
  <data key="d6">chunk-843cd03316121e01909837126fbbe24c</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;EMPLOYMENT CONTRACT&quot;" target="&quot;DOCUMENTATION OF ADDITIONAL FUNDS&quot;">
  <data key="d4">9.0</data>
