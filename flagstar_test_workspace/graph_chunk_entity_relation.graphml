  <data key="d2">chunk-787de407af176e62ce6eb517b2dd1d21</data>
  <data key="d3">[{"level": 0, "cluster": 16}, {"level": 1, "cluster": 180}, {"level": 2, "cluster": 449}]</data>
</node>
<node id="&quot;SCREENING PROCEDURES&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Screening Procedures are the methods used by subsidy providers to evaluate potential buyers for eligibility in affordable housing programs."</data>
  <data key="d2">chunk-787de407af176e62ce6eb517b2dd1d21</data>
