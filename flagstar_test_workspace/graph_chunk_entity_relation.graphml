  <data key="d6">chunk-c3fe3f1cf3ad46c315af5250198974ab</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;NON-OCCUPANT CO-BORROWER&quot;" target="&quot;MAXIMUM LTV/CLTV/HCLTV&quot;">
  <data key="d4">7.0</data>
