  <data key="d4">8.0</data>
  <data key="d5">"Freddie Mac's guidelines are also processed through the DU system, linking the two entities in the mortgage underwriting framework."</data>
  <data key="d6">chunk-2eef4940eec1ef97062f77d3efe4074e</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;LPA&quot;" target="&quot;CONVENTIONAL UNDERWRITING GUIDELINES&quot;">
  <data key="d4">8.0</data>
