  <data key="d7">1</data>
</edge>
<edge source="&quot;LPA&quot;" target="&quot;FREDDIE MAC&quot;">
  <data key="d4">15.0</data>
  <data key="d5">"FREDDIE MAC loans submitted to LPA do not require reviewing disputed tradelines that have been assessed already."&lt;SEP&gt;"LPA determines additional reserve requirements based on Freddie Mac guidelines for financed properties."</data>
