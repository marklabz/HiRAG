  <data key="d6">chunk-843cd03316121e01909837126fbbe24c</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;CURRENT INCOME&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"The Borrower’s Current Income affects the ability to qualify for the mortgage and is part of financial resources verification."</data>
  <data key="d6">chunk-3f01d27887cb1edc56efdd9355e2cbba</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;NEW PRIMARY EMPLOYMENT&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"The Borrower must have NEW PRIMARY EMPLOYMENT that meets the requirements outlined for mortgage qualification."</data>
  <data key="d6">chunk-3f01d27887cb1edc56efdd9355e2cbba</data>
  <data key="d7">1</data>
</edge>
