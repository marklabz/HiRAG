  <data key="d4">7.0</data>
  <data key="d5">"The borrower must provide a copy of the settlement statement to document their cash investment in the land."</data>
  <data key="d6">chunk-ebee13ef54f5a678a952e514a3a25998</data>
  <data key="d7">1</data>
</edge>
