  <data key="d2">chunk-cefb0ad4148eab93b794bfdc3eb3eac7</data>
</node>
<node id="&quot;MORTGAGE LIEN&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Mortgage Lien refers to the lender's legal claim against a property until the mortgage debt is paid off, establishing the lender's interest in the property."</data>
  <data key="d2">chunk-cefb0ad4148eab93b794bfdc3eb3eac7</data>
