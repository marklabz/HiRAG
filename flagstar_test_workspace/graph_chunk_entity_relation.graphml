<node id="&quot;FORBEARANCE&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Forbearance is a temporary relief option for borrowers allowing them to defer mortgage payments without penalties."&lt;SEP&gt;"Forbearance is an agreement that allows a borrower to temporarily pause or reduce mortgage payments, typically due to financial hardship, without affecting loan status."&lt;SEP&gt;"Forbearance is an agreement that allows a borrower to temporarily reduce or suspend payments on their loan, usually for specific financial hardships."</data>
  <data key="d2">chunk-61ba5485d92daa30adf4ee02bfab7d8a&lt;SEP&gt;chunk-1a05e768a9b64dd897dab3f97a6c234a&lt;SEP&gt;chunk-105c313a28b49198d2d2b78db6e7529b</data>
