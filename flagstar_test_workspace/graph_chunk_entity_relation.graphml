<node id="&quot;TOTAL NUMBER OF ROOMS&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Total Number of Rooms indicates the comprehensive count of rooms in a property, which is critical in assessing rental units and their market value."</data>
  <data key="d2">chunk-7a01c4d224477788cf5c6bfd6ccc84e2</data>
  <data key="d3">[{"level": 0, "cluster": 7}, {"level": 1, "cluster": 127}]</data>
</node>
<node id="&quot;RENTAL ANALYSIS DATA&quot;">
  <data key="d0">"CONCEPT"</data>
