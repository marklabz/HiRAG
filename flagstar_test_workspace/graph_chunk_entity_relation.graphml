  <data key="d6">chunk-23ec06f9f4a15f1cb40e52e628766be9</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;BORROWERS&quot;" target="&quot;BORROWER ELIGIBILITY&quot;">
