<node id="&quot;INCOME AND OVERALL CREDIT PROFILE&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Income and Overall Credit Profile is a comprehensive evaluation that lenders perform to assess a borrower's financial reliability and likelihood of repaying loans."</data>
  <data key="d2">chunk-3cd8475962bfe1c2428c1ea6691488c9</data>
  <data key="d3">[{"level": 0, "cluster": 32}, {"level": 1, "cluster": 231}]</data>
</node>
<node id="&quot;DOCUMENTED SOURCES&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Documented Sources refer to verified evidence provided by borrowers to prove the origins of their income or funds during the mortgage application process."</data>
