</edge>
<edge source="&quot;TAX RETURN&quot;" target="&quot;FANNIE MAE&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"FANNIE MAE requires the most recent tax return for mortgage loan applications, establishing a direct necessity for the tax return."</data>
  <data key="d6">chunk-4f5775363168aa3256002e8b909c2f52</data>
  <data key="d7">1</data>
</edge>
