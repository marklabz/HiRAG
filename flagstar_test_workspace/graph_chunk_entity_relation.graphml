  <data key="d7">1</data>
</edge>
<edge source="&quot;SALARY INCREASE&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"The Borrower's financial situation may be affected by a future salary increase as mentioned in the documentation requirements."</data>
  <data key="d6">chunk-909c805f10bec3b9745cd64c1852b1fd</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;LOAN PURPOSE&quot;" target="&quot;MORTGAGE&quot;">
  <data key="d4">14.0</data>
  <data key="d5">"The loan purpose directly influences the type of Mortgage being originated."&lt;SEP&gt;"The stated loan purpose influences the eligibility criteria under Fannie Mae and Freddie Mac for mortgages."</data>
  <data key="d6">chunk-909c805f10bec3b9745cd64c1852b1fd&lt;SEP&gt;chunk-9a9a7e59e34af57946c09cfa07672f92</data>
