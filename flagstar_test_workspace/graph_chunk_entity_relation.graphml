  <data key="d4">7.0</data>
  <data key="d5">"Having a two-year employment history is an important criterion for evaluating non-occupant co-borrowers."</data>
  <data key="d6">chunk-6261b628a88157f5bd4a959ee8fdb8f8</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;CO-SIGNER&quot;" target="&quot;GUARANTOR&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"Co-signers and guarantors play similar roles in loan transactions, providing additional security for lending."</data>
  <data key="d6">chunk-c3fe3f1cf3ad46c315af5250198974ab</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;GUARANTOR&quot;" target="&quot;EMPLOYMENT-CONTINGENT REPAYMENT PROGRAM&quot;">
