  <data key="d4">8.0</data>
  <data key="d5">"HomeReady mortgage loans are subject to specific conditions regarding default or refinancing that borrowers must understand."</data>
  <data key="d6">chunk-8cfec8ddeaba989b347c8cc9daa583b4</data>
  <data key="d7">1</data>
</edge>
