  <data key="d4">8.0</data>
  <data key="d5">"Fiancés of U.S. Citizens often require a visa for entry into the United States, allowing them to stay legally."</data>
  <data key="d6">chunk-d9f00ed91955a5d8af076ae0a21e6a69</data>
  <data key="d7">1</data>
</edge>
