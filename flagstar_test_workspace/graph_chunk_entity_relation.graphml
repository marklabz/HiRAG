  <data key="d4">7.0</data>
  <data key="d5">"Business income is influenced by the demand for the product, which is critical in evaluating the viability of the borrower's business."</data>
  <data key="d6">chunk-332ea40a8706fdd85456078cf47232fe</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;BORROWER’S BUSINESS&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">8.0</data>
