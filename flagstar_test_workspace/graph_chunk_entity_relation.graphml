</node>
<node id="&quot;FOREIGN SOURCES&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Foreign Sources refer to income originating from outside the U.S., which may be eligible for inclusion in mortgage applications under specific guidelines."</data>
  <data key="d2">chunk-31a563a8507e131e7544819dbd9373b4</data>
  <data key="d3">[{"level": 0, "cluster": 31}, {"level": 1, "cluster": 228}]</data>
</node>
<node id="&quot;CERTIFYING TRANSLATOR&quot;">
  <data key="d0">"PERSON"</data>
  <data key="d1">"A Certifying Translator is a professional who translates documents to English, ensuring compliance with mortgage documentation requirements when foreign income is involved."</data>
