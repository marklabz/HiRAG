  <data key="d3">[{"level": 0, "cluster": 34}, {"level": 1, "cluster": 245}]</data>
</node>
<node id="&quot;VERIFICATIONS OF MORTGAGE OR RENT (VOM)&quot;">
  <data key="d0">"TECHNOLOGY"</data>
  <data key="d1">"Verifications of Mortgage or Rent (VOM) are processes for confirming a borrower's repayment history on their existing mortgage or rent during the loan assessment."</data>
