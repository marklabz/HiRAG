</node>
<node id="&quot;GENERAL LOAN LIMITS&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"General Loan Limits represent the maximum amounts for mortgages established by financial authorities to reflect housing market conditions."</data>
  <data key="d2">chunk-e252311920cec13b843fb034a4a69e94</data>
