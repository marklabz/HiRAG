  <data key="d7">1</data>
</edge>
<edge source="&quot;BORROWER&quot;" target="&quot;VALIDITY OF LOAN APPLICATION&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"Validity of Loan Application rests on the accuracy and authenticity of the submitted information by the borrower while processing insurance needs."</data>
  <data key="d6"></data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;BORROWER&quot;" target="&quot;ACCOUNT LIEN AGREEMENTS&quot;">
