  <data key="d4">10.0</data>
  <data key="d5">"Lump-sum distribution funds must be derived from an eligible retirement asset, indicating a direct relationship between them."</data>
  <data key="d6">chunk-f67964fc288da88f7bb3defef1f29177</data>
  <data key="d7">1</data>
</edge>
