  <data key="d4">7.0</data>
  <data key="d5">"CURRENT INCOME can originate from the Borrower's employment starting no later than the EMPLOYMENT START DATE as specified."</data>
  <data key="d6">chunk-3f01d27887cb1edc56efdd9355e2cbba</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;EMPLOYMENT START DATE&quot;" target="&quot;NEW PRIMARY EMPLOYMENT&quot;">
  <data key="d4">6.0</data>
  <data key="d5">"NEW PRIMARY EMPLOYMENT's start date must align with the EMPLOYMENT START DATE for mortgage qualification purposes."</data>
  <data key="d6">chunk-3f01d27887cb1edc56efdd9355e2cbba</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;EMPLOYMENT START DATE&quot;" target="&quot;10-DAY PRE-CLOSING VERBAL VERIFICATION&quot;">
  <data key="d4">7.0</data>
