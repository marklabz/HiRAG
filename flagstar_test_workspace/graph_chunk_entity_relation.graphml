  <data key="d6">chunk-9a9a7e59e34af57946c09cfa07672f92</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;APPLICATION&quot;" target="&quot;MORTGAGE&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The application must include comprehensive information about the borrower's finances to qualify for a mortgage."</data>
  <data key="d6">chunk-9a9a7e59e34af57946c09cfa07672f92</data>
  <data key="d7">1</data>
</edge>
