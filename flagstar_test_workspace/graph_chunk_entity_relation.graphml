  <data key="d7">1</data>
</edge>
<edge source="&quot;BORROWER&quot;" target="&quot;PROOF OF ASSETS TO SATISFY LOAN REQUIREMENTS&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"Proof of Assets to Satisfy Loan Requirements demonstrates the financial resources available to the borrower for justifying their mortgage obligations."</data>
