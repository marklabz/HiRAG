<node id="&quot;ARCH&quot;">
  <data key="d0">"ORGANIZATION"</data>
  <data key="d1">"Arch is a company that provides mortgage insurance, helping lenders manage risk in the mortgage loan process."&lt;SEP&gt;"Arch is a mortgage insurance provider mentioned in the document as one of the companies offering MI underwriting services."</data>
  <data key="d2">chunk-ed0db69e97fa62c70a7cb29c5e75fe07&lt;SEP&gt;chunk-995f33933031b2ea33803f61f1ece1b7</data>
