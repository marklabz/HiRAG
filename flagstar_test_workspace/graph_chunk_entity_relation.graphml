  <data key="d6">chunk-cea98d6086733276bdd5c19993c4deb7</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;RENTAL INCOME&quot;" target="&quot;OPERATING AND MAINTENANCE COSTS&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"Operating and maintenance costs are deducted from rental income to provide a clear picture of net income from rental properties."</data>
  <data key="d6">chunk-cea98d6086733276bdd5c19993c4deb7</data>
  <data key="d7">1</data>
</edge>
