  <data key="d4">6.0</data>
  <data key="d5">"The mixed-use properties guidelines include provisions that allow for accessory units on designated parcels."</data>
  <data key="d6">chunk-c3e0ec6e1adaeb678f542089515e77ac</data>
  <data key="d7">1</data>
</edge>
