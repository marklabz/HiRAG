  <data key="d4">6.0</data>
  <data key="d5">"Mortgage assumptions can affect the borrower's real estate obligations when the purchaser assumes the mortgage."</data>
  <data key="d6">chunk-455b5668460db6760959b99f4a51a667</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;REAL ESTATE&quot;" target="&quot;MORTGAGE&quot;">
