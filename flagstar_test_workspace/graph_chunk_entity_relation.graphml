  <data key="d2">chunk-8a9ffcad15481c83b74cda33a0148728</data>
</node>
<node id="&quot;MARRIAGE LICENSE/CERTIFICATE&quot;">
  <data key="d0">"DOCUMENT"</data>
  <data key="d1">"Marriage License/Certificate serves as supporting documentation for claims related to gifts received from donors during wedding occasions."</data>
