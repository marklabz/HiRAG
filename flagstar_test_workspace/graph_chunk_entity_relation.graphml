</node>
<node id="&quot;ENVIRONMENTAL RISK EXPOSURE&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Environmental Risk Exposure includes various conditions such as mold, radon, and proximity to contaminated sites that may impact a property's value."</data>
  <data key="d2">chunk-756642bc27ab7956732455451eb4ce71</data>
  <data key="d3">[{"level": 0, "cluster": 11}, {"level": 1, "cluster": 147}, {"level": 2, "cluster": 406}]</data>
</node>
<node id="&quot;SFC 630&quot;">
  <data key="d0">"PRODUCT"</data>
