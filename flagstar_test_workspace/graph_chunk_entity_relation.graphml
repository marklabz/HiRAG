  <data key="d6">chunk-d14191b10a7b641a859301abcf2d9873</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;IRS FORM 1120S&quot;" target="&quot;SCHEDULE K-1&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"IRS Form 1120S also generates Schedule K-1 for S Corporations to report shareholder income."</data>
  <data key="d6">chunk-d14191b10a7b641a859301abcf2d9873</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;IRS FORM 1120S&quot;" target="&quot;PERSONAL RETURNS&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"IRS Form 1120S relates to S Corporations, which affects how income reported on personal returns is classified for qualification purposes."</data>
  <data key="d6">chunk-398938dbff78b05d0c3830d36e6918b6</data>
  <data key="d7">1</data>
</edge>
