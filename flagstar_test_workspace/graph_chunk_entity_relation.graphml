<node id="&quot;MONTHLY INCOME&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Monthly Income is the calculated income a borrower earns on a monthly basis based on their self-employment earnings."&lt;SEP&gt;"Monthly Income is the income calculated on a monthly basis, used to gauge the Borrower's financial capacity for loans and other obligations."&lt;SEP&gt;"Monthly income is the calculated regular earnings from employment, vital for determining loan repayment capability."&lt;SEP&gt;"Monthly income refers to the calculated income amount based on distributed RS or RSUs, divided for use in income assessments of borrowers."</data>
  <data key="d2">chunk-15bd1add6397f9fb7a5eda377f3403cf&lt;SEP&gt;chunk-332ea40a8706fdd85456078cf47232fe&lt;SEP&gt;chunk-843cd03316121e01909837126fbbe24c&lt;SEP&gt;chunk-6f91be92d53c1aed3b7126461f33e415</data>
  <data key="d3">[{"level": 0, "cluster": 2}, {"level": 1, "cluster": 72}, {"level": 2, "cluster": 293}]</data>
</node>
