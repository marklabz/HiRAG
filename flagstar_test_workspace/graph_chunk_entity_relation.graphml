</node>
<node id="&quot;SQUARE FEET OF FINISHED AREA&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Square Feet of Finished Area is a measurement used to determine the size of a dwelling, relevant for appraisals of ADUs and rental properties."</data>
  <data key="d2">chunk-7a01c4d224477788cf5c6bfd6ccc84e2</data>
  <data key="d3">[{"level": 0, "cluster": 7}, {"level": 1, "cluster": 127}]</data>
