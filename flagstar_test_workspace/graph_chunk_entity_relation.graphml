  <data key="d4">9.0</data>
  <data key="d5">"TOTAL DEBT-TO-INCOME RATIO is a critical measure in assessing the borrower's ability to take on additional debt based on their income including rental income."</data>
  <data key="d6">chunk-78e642bbbbe6e4f896abe6c8dfd4bab2</data>
  <data key="d7">1</data>
</edge>
