  <data key="d6">chunk-b9fd7a30043bf2ff61e50fbd6141d212</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;CO-BORROWER&quot;" target="&quot;NON-ARMS-LENGTH TRANSACTIONS&quot;">
  <data key="d4">6.0</data>
