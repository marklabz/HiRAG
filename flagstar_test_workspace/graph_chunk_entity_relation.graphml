  <data key="d4">8.0</data>
  <data key="d5">"HomeReady mortgage loans can be either fixed-rate or adjustable-rate, which affects borrower options based on their financial situation."</data>
  <data key="d6">chunk-8cfec8ddeaba989b347c8cc9daa583b4</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;BORROWER INCOME LIMITS&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">7.0</data>
