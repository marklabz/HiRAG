</node>
<node id="&quot;COVERAGE FOR APPRAISALS&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Coverage for Appraisals refers to the rules governing the age and validity of appraisal documents needed during the mortgage process."</data>
  <data key="d2">chunk-d864e2754e1d5a70d89033bc8babcdcc</data>
</node>
<node id="&quot;ASSESSMENTS&quot;">
