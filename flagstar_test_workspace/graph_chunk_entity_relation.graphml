</node>
<node id="&quot;DEPENDENT PARENTS BENEFITS&quot;">
  <data key="d0">"PRODUCT"</data>
  <data key="d1">"Dependent Parents Benefits refer to Social Security benefits paid to a parent of a disabled person, ensuring financial security for the family."</data>
  <data key="d2">chunk-3c5f3698bd3a35ae6c5127d81864d41d</data>
  <data key="d3">[{"level": 0, "cluster": 34}, {"level": 1, "cluster": 239}, {"level": 2, "cluster": 532}]</data>
</node>
<node id="&quot;INCOME QUALIFICATION&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Income Qualification is the assessment of a borrower's income stability and availability for mortgage lending purposes."&lt;SEP&gt;"Income Qualification refers to the criteria and documentation needed for a borrower to qualify for a mortgage based on their income sources."</data>
  <data key="d2">chunk-3c5f3698bd3a35ae6c5127d81864d41d&lt;SEP&gt;chunk-d3719c6acb29bd52b7e1e409b90cedc6</data>
