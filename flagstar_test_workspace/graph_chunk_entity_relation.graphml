  <data key="d6"></data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;UNDERWRITER&quot;" target="&quot;CONVENTIONAL UNDERWRITING GUIDELINES&quot;">
  <data key="d4">26.0</data>
  <data key="d5">"The UNDERWRITER must adhere to the CONVENTIONAL UNDERWRITING GUIDELINES when assessing loan applications."&lt;SEP&gt;"Underwriters apply conventional guidelines to assess the financial profiles of borrowers and potential risks."&lt;SEP&gt;"Underwriters utilize conventional underwriting guidelines to evaluate the financial viability of borrowers."</data>
  <data key="d6">chunk-c8fbac57b62fb040bd0302d8a94d9f65&lt;SEP&gt;chunk-3cd8475962bfe1c2428c1ea6691488c9</data>
