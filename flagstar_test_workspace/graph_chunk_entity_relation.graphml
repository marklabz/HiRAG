  <data key="d4">6.0</data>
  <data key="d5">"LEASE AGREEMENTS can be utilized as documentation to show financial obligations that contribute to EXTENUATING CIRCUMSTANCES during underwriting."</data>
  <data key="d6">chunk-2b4494b2a290a96f3ee6a9d358a812a8</data>
  <data key="d7">1</data>
</edge>
