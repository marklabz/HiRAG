  <data key="d3">[{"level": 0, "cluster": 31}, {"level": 1, "cluster": 230}]</data>
</node>
<node id="&quot;NON-PERMANENT RESIDENT ALIEN&quot;">
  <data key="d0">"PERSON"</data>
  <data key="d1">"A Non-Permanent Resident Alien is an individual seeking temporary entry to the United States for specific purposes, requiring verification of their legal presence."&lt;SEP&gt;"A Non-Permanent Resident Alien is an individual who is not a U.S. citizen but resides in the U.S. legally, with conditions regarding income documentation applicable to mortgage qualification."&lt;SEP&gt;"Non-Permanent Resident Alien refers to individuals who reside in the U.S. lawfully but are not permanent residents and must maintain lawful status."</data>
  <data key="d2">chunk-d9f00ed91955a5d8af076ae0a21e6a69&lt;SEP&gt;chunk-3ae330f51f478e78f1b91957f17dcdec&lt;SEP&gt;chunk-31a563a8507e131e7544819dbd9373b4</data>
