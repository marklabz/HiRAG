  <data key="d4">6.0</data>
  <data key="d5">"Lease Payments for Solar Panels may be excluded from the Debt-to-Income Ratio, indicating a financial consideration that affects financing decisions."</data>
  <data key="d6">chunk-e2c659b65edef4a5e599f9445602b752</data>
  <data key="d7">1</data>
</edge>
