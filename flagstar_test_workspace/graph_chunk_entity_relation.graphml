  <data key="d4">6.0</data>
  <data key="d5">"The status of property improvements affects overall property value and must be considered during lease agreements."</data>
  <data key="d6">chunk-b81be5b6336b17987b5cd27bc0cf519d</data>
  <data key="d7">1</data>
</edge>
