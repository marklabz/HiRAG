<node id="&quot;TRADE EQUITY&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Trade Equity is a financial consideration given to a borrower when existing property or assets are used as part of a down payment in real estate transactions."&lt;SEP&gt;"Trade Equity refers to the value derived from trading in a manufactured home as part of the financing for a new purchase."</data>
  <data key="d2">chunk-32546641e2f2fec0a52f658ed70fc338&lt;SEP&gt;chunk-ebee13ef54f5a678a952e514a3a25998</data>
