  <data key="d4">7.0</data>
  <data key="d5">"The SELF-EMPLOYMENT INCOME POLICY provisions affect the adjustments made in CASH FLOW ANALYSIS for determining qualifying income."</data>
  <data key="d6">chunk-27c5b5517eef234cf0db585936ec28f7</data>
  <data key="d7">1</data>
</edge>
