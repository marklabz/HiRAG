  <data key="d4">6.0</data>
  <data key="d5">"The borrower's history can be relevant for determining a qualifying exception under Fannie Mae guidelines."</data>
  <data key="d6">chunk-f7c7059ebd575d1369f6649db3e25ee4</data>
  <data key="d7">1</data>
</edge>
