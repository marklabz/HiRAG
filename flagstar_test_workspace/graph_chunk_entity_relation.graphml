<node id="&quot;CO-SIGNER&quot;">
  <data key="d0">"PERSON"</data>
  <data key="d1">"A Co-Signer is an individual who agrees to take responsibility for a loan but does not have ownership interest in the security property."&lt;SEP&gt;"A Co-signer is an individual who signs a loan agreement along with the borrower, potentially sharing responsibility for repayment without occupying the property."</data>
  <data key="d2">chunk-c3fe3f1cf3ad46c315af5250198974ab&lt;SEP&gt;chunk-b9fd7a30043bf2ff61e50fbd6141d212</data>
