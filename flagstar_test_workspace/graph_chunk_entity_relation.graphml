  <data key="d2">chunk-756642bc27ab7956732455451eb4ce71</data>
</node>
<node id="&quot;CONTAMINATION&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Contamination refers to the presence of hazardous materials that may adversely affect property value and require assessment during the appraisal process."</data>
  <data key="d2">chunk-756642bc27ab7956732455451eb4ce71</data>
