  <data key="d2">chunk-0f359b1edc6f123eca67b08265c9b89e</data>
  <data key="d3">[{"level": 0, "cluster": 18}, {"level": 1, "cluster": 195}, {"level": 2, "cluster": 481}]</data>
</node>
<node id="&quot;AUTHORIZED USER TRADELINES&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Authorized User Tradelines are accounts that a borrower is allowed to use within someone else's credit card account, which can impact their credit score and history."</data>
  <data key="d2">chunk-31dff4bfbf6291a2db9c4969e0f5cbe0</data>
