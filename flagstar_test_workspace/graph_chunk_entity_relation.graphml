  <data key="d4">6.0</data>
  <data key="d5">"Outstanding liens may include delinquent real estate taxes, establishing a direct relationship in financial obligations."</data>
  <data key="d6">chunk-9da80c7f63e32b0d7dc6df2ae9032546</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;EQUITY&quot;" target="&quot;CASH-OUT TRANSACTION&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"A cash-out transaction can be influenced by the equity that a borrower has in their home, linking these financial elements tightly."</data>
  <data key="d6">chunk-9da80c7f63e32b0d7dc6df2ae9032546</data>
  <data key="d7">1</data>
</edge>
