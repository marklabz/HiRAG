  <data key="d6">chunk-23ec06f9f4a15f1cb40e52e628766be9</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;BORROWERS&quot;" target="&quot;VESTED BALANCE&quot;">
  <data key="d4">6.0</data>
  <data key="d5">"The vested balance indicates how much of the funds borrowers can use from their accounts and is determined by their contributions."</data>
  <data key="d6">chunk-23ec06f9f4a15f1cb40e52e628766be9</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;BORROWERS&quot;" target="&quot;FUNDING REQUIREMENTS&quot;">
