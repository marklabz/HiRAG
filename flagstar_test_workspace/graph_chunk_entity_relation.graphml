  <data key="d4">8.0</data>
  <data key="d5">"ADU rental analysis is necessary to support the income reflected on the lease, determining the net rental income."</data>
  <data key="d6">chunk-151a292558f7e1fe4b393da7f73632a9</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;CURRENT LEASE AGREEMENT&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The current lease agreement is necessary for the borrower to document qualifying rental income in certain situations."</data>
  <data key="d6">chunk-d1fc933db1bd6fd3476c94d029ad8540</data>
  <data key="d7">1</data>
</edge>
