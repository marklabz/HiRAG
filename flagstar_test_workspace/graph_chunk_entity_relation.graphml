<node id="&quot;PREPAYMENT PENALTY&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Prepayment Penalty refers to fees incurred for paying off a loan early, which are prohibited in the outlined regulations."&lt;SEP&gt;"Prepayment Penalty refers to fees that may be charged if a borrower pays off a loan early, which are disallowed in current mortgage guidelines."</data>
  <data key="d2">chunk-46cceddf672b67421d8f87a3665f1ddf&lt;SEP&gt;chunk-d10b21d56993c3c6bc0aa80dd4168911</data>
