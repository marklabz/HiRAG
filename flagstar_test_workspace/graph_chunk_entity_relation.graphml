  <data key="d3">[{"level": 0, "cluster": 7}, {"level": 1, "cluster": 125}, {"level": 2, "cluster": 368}]</data>
</node>
<node id="&quot;LIQUIDITY&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Liquidity is a financial term that denotes the ability of an entity to cover its short-term obligations using its most liquid assets."&lt;SEP&gt;"Liquidity refers to how quickly and easily assets can be converted into cash without affecting its market price, important for businesses in meeting short-term obligations."</data>
  <data key="d2">chunk-27c5b5517eef234cf0db585936ec28f7&lt;SEP&gt;chunk-398938dbff78b05d0c3830d36e6918b6</data>
