  <data key="d4">8.0</data>
  <data key="d5">"The conversion of a principal residence into an investment property involves specific qualifying income considerations for underwriting."</data>
  <data key="d6">chunk-10ce55972cf12e21fd77796ab69a96ca</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;INVESTMENT PROPERTY&quot;" target="&quot;PITIA&quot;">
  <data key="d4">7.0</data>
