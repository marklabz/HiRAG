  <data key="d2">chunk-7feb44cc17f2e0c5783ac3ce2285717a&lt;SEP&gt;chunk-ce8ebe270f2feee194ded8e3d4becdb2</data>
  <data key="d3">[{"level": 0, "cluster": 23}, {"level": 1, "cluster": 202}, {"level": 2, "cluster": 488}]</data>
</node>
<node id="&quot;TN&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"TN refers to a nonimmigrant NAFTA Professional visa specifically for citizens of Canada and Mexico, highlighting regional employment agreements."</data>
  <data key="d2">chunk-7feb44cc17f2e0c5783ac3ce2285717a</data>
  <data key="d3">[{"level": 0, "cluster": 23}, {"level": 1, "cluster": 206}, {"level": 2, "cluster": 503}]</data>
</node>
