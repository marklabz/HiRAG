  <data key="d6">chunk-cefb0ad4148eab93b794bfdc3eb3eac7</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;ACCESSORY UNIT&quot;" target="&quot;FANNIE MAE&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"Fannie Mae has specific rules regarding accessory units, affecting eligibility for financing options."</data>
  <data key="d6">chunk-cefb0ad4148eab93b794bfdc3eb3eac7</data>
  <data key="d7">1</data>
</edge>
