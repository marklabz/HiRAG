  <data key="d6">chunk-756642bc27ab7956732455451eb4ce71</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;GUIDELINES&quot;" target="&quot;FREDDIE MAC&quot;">
  <data key="d4">8.0</data>
