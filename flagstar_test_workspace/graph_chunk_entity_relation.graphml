  <data key="d2">chunk-0f359b1edc6f123eca67b08265c9b89e</data>
  <data key="d3">[{"level": 0, "cluster": 18}, {"level": 1, "cluster": 188}, {"level": 2, "cluster": 473}]</data>
</node>
<node id="&quot;LOAN APPLICANTS&quot;">
  <data key="d0">"PERSON"</data>
  <data key="d1">"Loan Applicants are individuals seeking financial loans, responsible for providing accurate information regarding their credit history and financial circumstances."</data>
  <data key="d2">chunk-0f359b1edc6f123eca67b08265c9b89e</data>
  <data key="d3">[{"level": 0, "cluster": 18}, {"level": 1, "cluster": 188}, {"level": 2, "cluster": 473}]</data>
