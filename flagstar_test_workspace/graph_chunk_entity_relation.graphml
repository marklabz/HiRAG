  <data key="d5">"EARNINGS are integral to CASH FLOW ANALYSIS as they determine the financial viability of the business for loan qualification."</data>
  <data key="d6">chunk-27c5b5517eef234cf0db585936ec28f7</data>
  <data key="d7">1</data>
</edge>
