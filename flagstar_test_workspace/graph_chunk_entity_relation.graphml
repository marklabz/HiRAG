  <data key="d6">chunk-3eb9a9047b04f55e775ab1675823f162</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;REAL PROPERTY&quot;" target="&quot;LEASEHOLD ESTATE&quot;">
