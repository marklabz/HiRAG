  <data key="d0">"DOCUMENT"</data>
  <data key="d1">"Current Mortgage Account Statement is a financial document that details the borrower's mortgage balance, payments made, and due dates."</data>
  <data key="d2">chunk-105c313a28b49198d2d2b78db6e7529b</data>
