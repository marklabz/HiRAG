<node id="&quot;SUBJECT PROPERTY&quot;">
  <data key="d0">"LOCATION"</data>
  <data key="d1">"Subject Property refers to the specific property being appraised and considered in the financing process."&lt;SEP&gt;"Subject Property refers to the specific property being appraised and evaluated, crucial for assessing its market value."&lt;SEP&gt;"Subject Property refers to the specific property being appraised or evaluated in the context of its market value."&lt;SEP&gt;"Subject Property refers to the specific real estate being financed or being discussed in a transaction."&lt;SEP&gt;"Subject Property refers to the specific real estate being purchased in the transaction, crucial for assessing financing eligibility."&lt;SEP&gt;"Subject Property refers to the specific real estate property being appraised, which serves as the focal point for determining its value through comparisons with similar properties."&lt;SEP&gt;"Subject Property refers to the specific real estate property being evaluated for its solar panel financing and ownership status."&lt;SEP&gt;"The Subject Property is the specific real estate being assessed in the appraisal process, which serves as the basis for comparison against comparable properties."&lt;SEP&gt;"The subject property is the specific real estate being appraised or sold, under evaluation for its marketability and value."</data>
  <data key="d2">chunk-24638398312c4aec93c00e795739cbf9&lt;SEP&gt;chunk-8d2d43086c2d67020db933397546a228&lt;SEP&gt;chunk-f443d70c1b97ab92c6f9f441ec9ced99&lt;SEP&gt;chunk-ea0854aedb400acc54c26d78db5065c4&lt;SEP&gt;chunk-e98d878b21daedfefbf36b036612418f&lt;SEP&gt;chunk-8a9ffcad15481c83b74cda33a0148728&lt;SEP&gt;chunk-6434821b2faf91ece4b375276017b775&lt;SEP&gt;chunk-8fb1c993d98cbaba5a6755fc57b9ff69&lt;SEP&gt;chunk-42fe7768b333d42fc15f00fc4e0ba0d3</data>
  <data key="d3">[{"level": 0, "cluster": 11}, {"level": 1, "cluster": 140}, {"level": 2, "cluster": 390}]</data>
</node>
<node id="&quot;CREDIT CARD REWARDS&quot;">
  <data key="d0">"PRODUCT"</data>
  <data key="d1">"Credit Card Rewards are points accumulated through credit card usage that can be converted to cash for use in financial transactions, such as closing costs or down payments."</data>
  <data key="d2">chunk-d30aff8ce4b53c163b59f9369ea58842</data>
  <data key="d3">[{"level": 0, "cluster": 3}, {"level": 1, "cluster": 84}]</data>
