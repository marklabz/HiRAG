  <data key="d6">chunk-446d02f0d6609ee8a932eea7a8d1302e</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;LUMP-SUM DISTRIBUTION&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"The Borrower must be the recipient of the lump-sum distribution funds, establishing a direct link between the Borrower and Lump-Sum Distribution."</data>
  <data key="d6">chunk-f67964fc288da88f7bb3defef1f29177</data>
  <data key="d7">1</data>
</edge>
