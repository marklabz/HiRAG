  <data key="d3">[{"level": 0, "cluster": 6}, {"level": 1, "cluster": 114}, {"level": 2, "cluster": 358}]</data>
</node>
<node id="&quot;MARKET RENT APPLICABLE TO THE ADU&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Market Rent Applicable to the ADU refers to the standard amount that similar accessory dwelling units could rent for in the local market."</data>
  <data key="d2">chunk-7a01c4d224477788cf5c6bfd6ccc84e2</data>
</node>
<node id="&quot;ZONING&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Zoning is the legal framework that determines how land can be used, impacting the legality and arrangement of accessory dwelling units (ADUs)."&lt;SEP&gt;"Zoning refers to the legal restrictions governing land use, which must reflect the highest and best use of the land and influence property appraisals."&lt;SEP&gt;"Zoning refers to the regulatory framework governing land use and development, influencing how properties can be utilized within a given area."</data>
  <data key="d2">chunk-7a01c4d224477788cf5c6bfd6ccc84e2&lt;SEP&gt;chunk-bd684789b748cb20186f7859db539838&lt;SEP&gt;chunk-5e26a3be3838ff40fb61edfe66e0268a</data>
