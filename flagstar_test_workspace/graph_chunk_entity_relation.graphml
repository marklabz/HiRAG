  <data key="d4">7.0</data>
  <data key="d5">"LARGE DEPOSIT amounts necessitate specific DOCUMENTATION REQUIREMENTS as part of the loan approval process."</data>
  <data key="d6">chunk-3cd8475962bfe1c2428c1ea6691488c9</data>
