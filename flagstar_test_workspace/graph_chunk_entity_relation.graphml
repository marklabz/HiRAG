  <data key="d2">chunk-cefb0ad4148eab93b794bfdc3eb3eac7</data>
</node>
<node id="&quot;FLOODPLAINS&quot;">
  <data key="d0">"LOCATION"</data>
  <data key="d1">"Floodplains are low-lying areas adjacent to rivers or lakes that are prone to flooding, which can affect property insurance and marketability."</data>
  <data key="d2">chunk-cefb0ad4148eab93b794bfdc3eb3eac7</data>
