  <data key="d4">17.0</data>
  <data key="d5">"Fannie Mae establishes parameters that influence the mortgage qualification process."&lt;SEP&gt;"Fannie Mae provides guidelines for mortgages that include specific eligibility and underwriting criteria."</data>
  <data key="d6">chunk-c8fbac57b62fb040bd0302d8a94d9f65&lt;SEP&gt;chunk-9a9a7e59e34af57946c09cfa07672f92</data>
  <data key="d7">1</data>
</edge>
