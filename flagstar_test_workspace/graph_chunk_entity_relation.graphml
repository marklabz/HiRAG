  <data key="d4">7.0</data>
  <data key="d5">"Loan features set by Flagstar include specific guidelines impacting eligibility for owner-occupied loans."</data>
  <data key="d6">chunk-d0ff713c7eebcf293485e860ba8cc6a1</data>
  <data key="d7">1</data>
</edge>
