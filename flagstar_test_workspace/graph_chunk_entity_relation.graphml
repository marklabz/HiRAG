  <data key="d6">chunk-446d02f0d6609ee8a932eea7a8d1302e</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;APPLICATION&quot;" target="&quot;OCUPANCY&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"Occupancy types are required to be specified in the Application to determine eligibility for loan terms."</data>
  <data key="d6">chunk-446d02f0d6609ee8a932eea7a8d1302e</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;APPLICATION&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"Application is a collective term that summarizes steps and documents needed for borrowers to apply for a loan, elaborating on their financial situation."</data>
  <data key="d6"></data>
  <data key="d7">1</data>
</edge>
