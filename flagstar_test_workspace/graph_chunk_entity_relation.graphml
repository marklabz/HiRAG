  <data key="d0">"NORM_ENTITY"</data>
  <data key="d1">"Requirements are the stipulated conditions and criteria that borrowers must meet to qualify for a loan or financial service."&lt;SEP&gt;"Requirements refer to a set of conditions or criteria that must be met to qualify for a loan or refinancing."</data>
  <data key="d2">chunk-f76dd878d76d1e8bdf5fb1cac46447ae&lt;SEP&gt;chunk-0f359b1edc6f123eca67b08265c9b89e</data>
