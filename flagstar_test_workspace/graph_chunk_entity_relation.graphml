</edge>
<edge source="&quot;STABLE INCOME&quot;" target="&quot;VOLUNTARY PAYMENTS&quot;">
  <data key="d4">6.0</data>
  <data key="d5">"Voluntary payments are not considered stable income for qualifying purposes, which affects a borrower's ability to secure a mortgage."</data>
  <data key="d6">chunk-9004bef6d0a745fff75d973c6b90ef4a</data>
  <data key="d7">1</data>
</edge>
