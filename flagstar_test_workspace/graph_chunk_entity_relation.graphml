  <data key="d6">chunk-0610be8f2c48d2ab9263a9d9aea08a29</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;DEBT-TO-INCOME RATIO&quot;" target="&quot;INTEREST RATE&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The interest rate for a mortgage may be influenced by the borrower’s debt-to-income ratio."</data>
  <data key="d6">chunk-0610be8f2c48d2ab9263a9d9aea08a29</data>
  <data key="d7">1</data>
</edge>
