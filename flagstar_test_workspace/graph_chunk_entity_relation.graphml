  <data key="d6">chunk-8cfec8ddeaba989b347c8cc9daa583b4</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;TRANSACTION TYPES&quot;" target="&quot;BORROWER&quot;">
  <data key="d4">6.0</data>
  <data key="d5">"Transaction types define the conditions under which a borrower can engage in property purchases or refinances relative to subsidy provider guidelines."</data>
  <data key="d6">chunk-8cfec8ddeaba989b347c8cc9daa583b4</data>
  <data key="d7">1</data>
</edge>
