  <data key="d2">chunk-15bd1add6397f9fb7a5eda377f3403cf</data>
  <data key="d3">[{"level": 0, "cluster": 1}, {"level": 1, "cluster": 51}]</data>
</node>
<node id="&quot;VARIABLE INCOME SECTION&quot;">
