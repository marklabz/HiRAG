  <data key="d5">"Both metrics (square feet of finished area and total number of rooms) are required for appraisal of the ADU."</data>
  <data key="d6">chunk-7a01c4d224477788cf5c6bfd6ccc84e2</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;VACANCIES&quot;" target="&quot;OPERATING AND MAINTENANCE COSTS&quot;">
  <data key="d4">12.0</data>
  <data key="d5">"Vacancies directly affect the calculation of operating and maintenance costs for rental income assessment."&lt;SEP&gt;"Vacancies influence expected operating and maintenance costs, impacting profit calculations for rental properties."</data>
  <data key="d6">chunk-7a01c4d224477788cf5c6bfd6ccc84e2&lt;SEP&gt;chunk-cea98d6086733276bdd5c19993c4deb7</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;OPERATING AND MAINTENANCE COSTS&quot;" target="&quot;UNEXPECTED EXPENSES&quot;">
  <data key="d4">7.0</data>
