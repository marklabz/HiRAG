  <data key="d4">8.0</data>
  <data key="d5">"The Affordable Second creates a subsidized sales price based on the difference between the market sale price and the resale-restricted price."</data>
  <data key="d6">chunk-787de407af176e62ce6eb517b2dd1d21</data>
  <data key="d7">1</data>
</edge>
