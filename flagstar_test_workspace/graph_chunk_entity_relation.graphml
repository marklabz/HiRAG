  <data key="d6">chunk-31dff4bfbf6291a2db9c4969e0f5cbe0</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;FINANCIAL ASSETS&quot;" target="&quot;VESTED STOCK OPTIONS&quot;">
  <data key="d4">8.0</data>
