  <data key="d4">6.0</data>
  <data key="d5">"IRS documentation may be required for the VERIFICATION OF DEBT related to the BORROWER’s finances."</data>
  <data key="d6">chunk-023647e2d4d4ed50a6e5f501c055a8b5</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;IRS&quot;" target="&quot;BUSINESS TAX RETURN&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"The BUSINESS TAX RETURN must be submitted to the IRS for the BORROWER’s documentation processes."</data>
  <data key="d6">chunk-023647e2d4d4ed50a6e5f501c055a8b5</data>
  <data key="d7">1</data>
</edge>
