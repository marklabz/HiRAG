</node>
<node id="&quot;MGIC&quot;">
  <data key="d0">"ORGANIZATION"</data>
  <data key="d1">"MGIC is a mortgage insurance provider that offers coverage options for lenders to mitigate risk associated with high LTV loans."&lt;SEP&gt;"MGIC is a mortgage insurance provider that protects lenders from defaults on mortgage loans, facilitating access to home financing."</data>
  <data key="d2">chunk-ed0db69e97fa62c70a7cb29c5e75fe07&lt;SEP&gt;chunk-995f33933031b2ea33803f61f1ece1b7</data>
