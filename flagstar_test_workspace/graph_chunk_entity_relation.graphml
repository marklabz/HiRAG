  <data key="d4">8.0</data>
  <data key="d5">"Both Social Security Income and Supplemental Security Income (SSI) are non-taxable sources that may be used for qualification purposes, as they belong to the same category of benefits related to income verification."</data>
  <data key="d6">chunk-9bd9610961bbb8effa4b39adbc65bddc</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;SOCIAL SECURITY INCOME&quot;" target="&quot;SSA&quot;">
  <data key="d4">9.0</data>
