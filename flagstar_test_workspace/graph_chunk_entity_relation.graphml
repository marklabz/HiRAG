  <data key="d4">8.0</data>
  <data key="d5">"DU issues specific requirements for employment verification that relate directly to mortgage applications and underwriting processes."</data>
  <data key="d6">chunk-2eef4940eec1ef97062f77d3efe4074e</data>
  <data key="d7">1</data>
</edge>
