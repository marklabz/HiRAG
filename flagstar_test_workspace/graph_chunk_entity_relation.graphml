  <data key="d0">"TECHNOLOGY"</data>
  <data key="d1">"Automated Underwriting System(s) refers to the software used to evaluate loan applications and make risk assessments based on credit history."</data>
  <data key="d2">chunk-9480c322229448ccd0b724ce848cac14</data>
  <data key="d3">[{"level": 0, "cluster": 18}, {"level": 1, "cluster": 188}, {"level": 2, "cluster": 471}]</data>
