  <data key="d6">chunk-31a563a8507e131e7544819dbd9373b4</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;TAX RETURN&quot;" target="&quot;ROYALTY PAYMENTS&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"Borrowers must provide their most recent signed federal income tax return when using royalty payments for qualification."</data>
  <data key="d6">chunk-95358b428c5f107947a116a0643878c1</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;TAX RETURN&quot;" target="&quot;VERIFICATION LETTER&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"Tax returns may also require a verification letter to validate income claims, establishing their relationship in financial applications."</data>
  <data key="d6">chunk-9bd9610961bbb8effa4b39adbc65bddc</data>
  <data key="d7">1</data>
</edge>
