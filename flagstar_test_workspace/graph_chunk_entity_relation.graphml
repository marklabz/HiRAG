<node id="&quot;CO-BORROWER&quot;">
  <data key="d0">"PERSON"</data>
  <data key="d1">"A Co-Borrower is any additional borrower listed on a loan application besides the primary borrower, responsible for the loan."&lt;SEP&gt;"A Co-borrower is an individual who shares the borrowing responsibility in a loan agreement, but may not occupy the property in certain transactions."</data>
  <data key="d2">chunk-c3fe3f1cf3ad46c315af5250198974ab&lt;SEP&gt;chunk-b9fd7a30043bf2ff61e50fbd6141d212</data>
