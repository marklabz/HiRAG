</edge>
<edge source="&quot;BORROWERS&quot;" target="&quot;INDIVIDUAL DEVELOPMENT ACCOUNTS&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"Borrowers can utilize funds from Individual Development Accounts for down payments and closing costs."</data>
  <data key="d6">chunk-23ec06f9f4a15f1cb40e52e628766be9</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;BORROWERS&quot;" target="&quot;LIFE INSURANCE POLICY&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"Borrowers can access life insurance policy cash values to assist in meeting closing costs and other financial requirements."</data>
  <data key="d6">chunk-23ec06f9f4a15f1cb40e52e628766be9</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;BORROWERS&quot;" target="&quot;POOLED SAVINGS&quot;">
  <data key="d4">8.0</data>
