</node>
<node id="&quot;MORTGAGE INSURANCE PROVIDERS&quot;">
  <data key="d0">"ORGANIZATION"</data>
  <data key="d1">"Mortgage Insurance Providers are companies that offer mortgage insurance policies to lenders, ensuring coverage against borrower default."</data>
  <data key="d2">chunk-995f33933031b2ea33803f61f1ece1b7</data>
  <data key="d3">[{"level": 0, "cluster": 5}, {"level": 1, "cluster": 101}, {"level": 2, "cluster": 340}]</data>
