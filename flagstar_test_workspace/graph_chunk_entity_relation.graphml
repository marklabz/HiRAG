  <data key="d4">8.0</data>
  <data key="d5">"Mortgaging is permitted on the leasehold estate, indicating a financial relationship between them."</data>
  <data key="d6">chunk-5a008bee56d46d46fc9de7e014d26695</data>
  <data key="d7">1</data>
</edge>
