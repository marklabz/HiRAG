  <data key="d6">chunk-d1fc933db1bd6fd3476c94d029ad8540</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;RENOVATION COSTS&quot;" target="&quot;PROPERTY MANAGEMENT EXPERIENCE&quot;">
  <data key="d4">6.0</data>
  <data key="d5">"Renovation costs need to be documented and can support the property management experience requirement for rental income validation."</data>
  <data key="d6">chunk-10ce55972cf12e21fd77796ab69a96ca</data>
  <data key="d7">1</data>
</edge>
