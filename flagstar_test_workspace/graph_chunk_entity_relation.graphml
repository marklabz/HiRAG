  <data key="d6">chunk-b81be5b6336b17987b5cd27bc0cf519d</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;LEASEHOLD ESTATE&quot;" target="&quot;LESSOR&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The lessor grants the leasehold estate to the lessee under the terms of a lease."</data>
  <data key="d6">chunk-5a008bee56d46d46fc9de7e014d26695</data>
