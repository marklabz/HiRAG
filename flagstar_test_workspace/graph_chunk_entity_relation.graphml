  <data key="d4">9.0</data>
  <data key="d5">"The borrower may receive resale proceeds from the sale of the property unless limited by resale restrictions."</data>
  <data key="d6">chunk-1da51e05e6600babe4a36494acdf7928</data>
  <data key="d7">1</data>
</edge>
