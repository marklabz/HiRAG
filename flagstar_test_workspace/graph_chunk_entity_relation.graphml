  <data key="d7">1</data>
</edge>
<edge source="&quot;NIS&quot;" target="&quot;CERTIFICATE OF COMPLETION&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"Programs that comply with NIS standards provide a certificate of completion for participants."</data>
  <data key="d6">chunk-7af9f372a5143b38d8551b1bc9a9f8f7</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;REFI POSSIBLE&quot;" target="&quot;FREDDIE MAC&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"FREDDIE MAC provides the Refi Possible program as a refinancing option, linking them closely."</data>
  <data key="d6">chunk-9da80c7f63e32b0d7dc6df2ae9032546</data>
  <data key="d7">1</data>
</edge>
