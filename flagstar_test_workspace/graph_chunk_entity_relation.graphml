  <data key="d5">"Closing Costs are the expenses that must be settled before the Closing takes place."&lt;SEP&gt;"Closing costs are incurred during the Closing of the mortgage transaction."</data>
  <data key="d6">chunk-909c805f10bec3b9745cd64c1852b1fd</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;CLOSING&quot;" target="&quot;DOCUMENTATION REQUIREMENTS&quot;">
  <data key="d4">16.0</data>
  <data key="d5">"Certain documentation requirements must be completed before Closing."&lt;SEP&gt;"Closing proceedings are contingent upon meeting all Documentation Requirements beforehand."</data>
  <data key="d6">chunk-909c805f10bec3b9745cd64c1852b1fd</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;CLOSING&quot;" target="&quot;DELIVERY DATE&quot;">
  <data key="d4">7.0</data>
