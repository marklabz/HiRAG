  <data key="d4">7.0</data>
  <data key="d5">"Contingent Fees are tied to the repercussions associated with an Early Payment Default for the Borrower."</data>
  <data key="d6">chunk-662a2c10d200da7291e0212d33749544</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;CONTINGENT FEES&quot;" target="&quot;RESCINDED LOAN FEE&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"Contingent fees are related to amounts refunded including the rescinded loan fee, showing their interrelation under a refund process."</data>
  <data key="d6">chunk-42d99ce4642f1e6e8c39678043a90b1e</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;CONTINGENT FEES&quot;" target="&quot;CORRESPONDENTS&quot;">
  <data key="d4">6.0</data>
