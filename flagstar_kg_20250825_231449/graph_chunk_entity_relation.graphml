<node id="&quot;UNSECURED LOANS&quot;">
  <data key="d0">"PRODUCT"</data>
  <data key="d1">"Unsecured Loans are loans that do not require collateral and are not addressed in the guidelines for down payment assistance programs."</data>
  <data key="d2">chunk-437272f81cc4575a4fa57f55ce8d121c</data>
</node>
<node id="&quot;PREPAIDS&quot;">
  <data key="d0">"CONCEPT"</data>
