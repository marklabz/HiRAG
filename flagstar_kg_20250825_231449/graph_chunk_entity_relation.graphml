  <data key="d4">8.0</data>
  <data key="d5">"This early loan payoff fee is determined by the greater value of the total premium price or 1.50%, establishing a financial condition in fees for Conventional Loans."</data>
  <data key="d6">chunk-bf2d9f6b5b471373ca78f75c11d02725</data>
  <data key="d7">1</data>
</edge>
