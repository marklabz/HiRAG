<node id="&quot;CASH BACK&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Cash Back refers to the amount of money that a borrower cannot receive at loan closing, highlighting restrictions on borrowing."&lt;SEP&gt;"Cash Back refers to the maximum amount of money that can be returned to a borrower after paying off non-mortgage debts, as part of a financial transaction or loan agreement."</data>
  <data key="d2">chunk-2315e50dabd40110b33a2bac5e271cc5&lt;SEP&gt;chunk-6a2fe6bde08b88616e4d4932fe5f5e5c</data>
