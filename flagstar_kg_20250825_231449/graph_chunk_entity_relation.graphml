<node id="&quot;COVERAGE AMOUNT&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Coverage amount refers to the maximum liability that the title insurance policy covers for potential claims or defects in title."</data>
  <data key="d2">chunk-9351b24bca225d97ff2d45b46310a878</data>
