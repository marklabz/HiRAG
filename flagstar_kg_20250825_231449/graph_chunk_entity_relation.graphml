  <data key="d6">chunk-7c977b52194d7751d347d7a9c63060b4</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;BORROWER&quot;" target="&quot;SUBORDINATE FINANCING&quot;">
  <data key="d4">16.0</data>
  <data key="d5">"Borrowers often utilize subordinate financing options to enhance their purchasing power, indicating a direct relationship."&lt;SEP&gt;"Subordinate financing regulations directly impact Borrowers in financing transactions, establishing a relevant relationship."</data>
  <data key="d6">chunk-6f08c1849f1a1e52584c06fc2286667f&lt;SEP&gt;chunk-7c977b52194d7751d347d7a9c63060b4</data>
