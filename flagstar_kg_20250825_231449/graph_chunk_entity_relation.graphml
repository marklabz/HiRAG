  <data key="d2">chunk-af318020d8f16430d1a60515a789d41d</data>
  <data key="d3">[{"level": 0, "cluster": 5}, {"level": 1, "cluster": 83}, {"level": 2, "cluster": 422}]</data>
</node>
<node id="&quot;LOAN CONDITIONS&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Loan Conditions refer to the specific requirements that must be met for a loan to qualify for the float-down renegotiation process."</data>
  <data key="d2">chunk-af318020d8f16430d1a60515a789d41d</data>
</node>
<node id="&quot;CURRENT PRICE&quot;">
