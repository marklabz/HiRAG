  <data key="d7">1</data>
</edge>
<edge source="&quot;LOAN&quot;" target="&quot;FLAGSTAR BANK&quot;">
  <data key="d4">27.5</data>
  <data key="d5">"A Loan is a financial product that Flagstar Bank offers to borrowers in various forms, subject to interest and repayment terms."&lt;SEP&gt;"Loans are products provided by Flagstar Bank for various purposes, including mortgages."&lt;&lt;SEP&gt;"Loans represent the core offering of Flagstar Bank, illustrating their primary business function."</data>
  <data key="d6"></data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;LOAN&quot;" target="&quot;SELF EMPLOYED&quot;">
  <data key="d4">10.0</data>
