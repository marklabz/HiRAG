  <data key="d4">9.0</data>
  <data key="d5">"The mortgage purchase is completed through a closing process that finalizes the transaction."</data>
  <data key="d6">chunk-e91d1878db3c593f090cf301ec4048a9</data>
  <data key="d7">1</data>
</edge>
