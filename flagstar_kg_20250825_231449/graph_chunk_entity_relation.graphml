<node id="&quot;CASH OUT REFINANCES&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"Cash Out Refinances refer to a mortgage transaction where existing equity in a home is converted to cash, subject to many conditions and limits."</data>
  <data key="d2">chunk-b36f295c3826a6aa7ec78dac1c05c756</data>
