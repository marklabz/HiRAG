</node>
<node id="&quot;BORROWER'S CONTRIBUTION&quot;">
  <data key="d0">"REQUIREMENT"</data>
  <data key="d1">"Borrower's Contribution is a necessary out-of-pocket payment that a borrower must make towards the purchase price of a property."</data>
  <data key="d2">chunk-ca3069902295dcf5b2b505753d7623f3</data>
</node>
<node id="&quot;PROPERTY APPRAISAL&quot;">
  <data key="d0">"PROCESS"</data>
