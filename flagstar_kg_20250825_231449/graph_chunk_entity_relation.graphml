  <data key="d6">chunk-a40aeeabaca2a4a97b1dd8ad35ab142e</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;CLOSING&quot;" target="&quot;TRANSFER OF TITLE&quot;">
  <data key="d4">18.0</data>
  <data key="d5">"Closing culminates in the Transfer of Title, finalizing the sale of the Mortgage Loan."&lt;SEP&gt;"The Transfer of Title occurs at Closing when legal ownership of the Mortgage Loan is transferred."</data>
