  <data key="d4">6.0</data>
  <data key="d5">"Document #3105 refers to the Appraisal Release Form needed for the appraisal process, linking administrative procedures to the fee structure."</data>
  <data key="d6">chunk-bf2d9f6b5b471373ca78f75c11d02725</data>
  <data key="d7">1</data>
</edge>
