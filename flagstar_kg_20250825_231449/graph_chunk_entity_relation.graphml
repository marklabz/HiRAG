  <data key="d6">chunk-1418f5447a956615e29938e7c6f0f71a</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;INTEREST-ONLY PAYMENTS&quot;" target="&quot;CONSTRUCTION PERIOD&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"Interest-only payments are typically made during the construction period, establishing a timeline relationship."</data>
  <data key="d6">chunk-0908ef3e42a9d0bcd40742960e19dbf2</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;INTEREST-ONLY PAYMENTS&quot;" target="&quot;CLOSING DISCLOSURES&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"Interest-only payments must be disclosed in closing documentation, ensuring borrower awareness and compliance."</data>
  <data key="d6">chunk-0908ef3e42a9d0bcd40742960e19dbf2</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;INTEREST-ONLY PAYMENTS&quot;" target="&quot;CONSTRUCTION LOAN&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"Interest-only payments are a feature of construction loans, supporting the borrower's financial management during the building phase."</data>
  <data key="d6">chunk-0908ef3e42a9d0bcd40742960e19dbf2</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;INTEREST-ONLY PAYMENTS&quot;" target="&quot;INTEREST CREDIT&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"Interest credits impact the calculations of interest-only payments during the construction phase, linking their financial implications."</data>
  <data key="d6">chunk-0908ef3e42a9d0bcd40742960e19dbf2</data>
  <data key="d7">1</data>
</edge>
