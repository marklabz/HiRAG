  <data key="d6">chunk-e4823f54b9e7afeaec0c69de7747fd4e</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;RESTRICTIVE AGREEMENTS&quot;" target="&quot;ARCHITECTURAL MATTERS&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"Architectural matters are commonly addressed in restrictive agreements, dictating permissible design and construction practices."</data>
  <data key="d6">chunk-e4823f54b9e7afeaec0c69de7747fd4e</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;RESTRICTIVE AGREEMENTS&quot;" target="&quot;PROPERTY RIGHTS&quot;">
  <data key="d4">6.0</data>
  <data key="d5">"Restrictive agreements do not negate property rights but rather establish guidelines for their exercise and limitations."</data>
  <data key="d6">chunk-e4823f54b9e7afeaec0c69de7747fd4e</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;RESTRICTIVE AGREEMENTS&quot;" target="&quot;COVENANTS&quot;">
  <data key="d4">7.0</data>
