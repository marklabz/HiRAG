  <data key="d4">9.0</data>
  <data key="d5">"The Adverse Action Letter is issued as a formal response to a Loan Denial, explaining the reasons for the denial to the Borrower."</data>
  <data key="d6">chunk-662a2c10d200da7291e0212d33749544</data>
  <data key="d7">1</data>
</edge>
