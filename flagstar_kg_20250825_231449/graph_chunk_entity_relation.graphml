  <data key="d2">chunk-9351b24bca225d97ff2d45b46310a878</data>
</node>
<node id="&quot;VARIABLE RATE MORTGAGES&quot;">
  <data key="d0">"PRODUCT"</data>
  <data key="d1">"Variable Rate Mortgages are a type of adjustable-rate mortgage that may fluctuate based on the market, requiring specific ALTA forms for coverage."&lt;SEP&gt;"Variable Rate Mortgages are loans characterized by fluctuating interest rates, which necessitate title insurance forms relevant to this mortgage type."</data>
  <data key="d2">chunk-9351b24bca225d97ff2d45b46310a878&lt;SEP&gt;chunk-970955acc105f7936d7b684983cc4b58</data>
