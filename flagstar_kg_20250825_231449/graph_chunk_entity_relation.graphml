<node id="&quot;LPA (LOAN PRODUCT ADVISOR)&quot;">
  <data key="d0">"TECHNOLOGY"</data>
  <data key="d1">"LPA (Loan Product Advisor) is an automated underwriting tool that helps lenders assess loan risk and borrower qualifications."&lt;SEP&gt;"Loan Product Advisor (LPA) is an automated underwriting tool that helps lenders assess mortgage applications and determine eligibility for various loan products."</data>
  <data key="d2">chunk-f1b06bf2c39f8da79b3399842638c80b&lt;SEP&gt;chunk-bd0c5c971a5a48bbded5da8b256a175c</data>
