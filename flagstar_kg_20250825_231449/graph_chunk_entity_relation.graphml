  <data key="d4">10.0</data>
  <data key="d5">"Bank statements are a key component of income documentation necessary for verifying a borrower's financial status."</data>
  <data key="d6">chunk-652c3091f21b7e8483d1309884976c82</data>
  <data key="d7">1</data>
</edge>
