  <data key="d6">chunk-da6a7f245e88177bac6b85d5f808ebd3</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;MORTGAGE LOAN&quot;" target="&quot;TITLE INSURANCE&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"Title insurance protects against financial loss from defects in title to real property, which is directly related to mortgage loans."</data>
  <data key="d6">chunk-9351b24bca225d97ff2d45b46310a878</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;MORTGAGE LOAN&quot;" target="&quot;LEGAL DESCRIPTION&quot;">
