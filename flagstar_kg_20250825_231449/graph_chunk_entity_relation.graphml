  <data key="d2">chunk-1418f5447a956615e29938e7c6f0f71a</data>
</node>
<node id="&quot;CONSTRUCTION INTEREST RATE&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Construction Interest Rate refers to the additional percentage added to the permanent interest rate on loans during the construction phase."</data>
