<node id="&quot;AMORTIZING PAYMENTS&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Amortizing Payments are regular payments made by the borrower that gradually pay off the principal and interest of the loan over time."</data>
