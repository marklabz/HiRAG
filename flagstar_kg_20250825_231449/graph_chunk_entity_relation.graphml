  <data key="d6">chunk-f1451e00f0a33296b7172a8a2f00a036</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;CONTINGENT FEES&quot;" target="&quot;UP FRONT MIP FEE&quot;">
  <data key="d4">13.0</data>
  <data key="d5">"Contingent Fees may be assessed alongside the Up Front MIP Fee, dictating additional costs related to loan processing."&lt;SEP&gt;"The Up Front MIP Fee works in conjunction with Contingent Fees, dictating financial obligations based on loan specifics."</data>
  <data key="d6">chunk-f1451e00f0a33296b7172a8a2f00a036</data>
  <data key="d7">1</data>
</edge>
