  <data key="d4">8.0</data>
  <data key="d5">"For Government Loans, this early loan payoff fee is contingent on the higher value of the total premium price or 1.75%, linking them financial agreements."</data>
  <data key="d6">chunk-bf2d9f6b5b471373ca78f75c11d02725</data>
  <data key="d7">1</data>
</edge>
