  <data key="d6">chunk-8c6c6dd97681ba9caa6c83d8ddf9ec59</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;MANDATORY LOCK-IN COMMITMENT&quot;" target="&quot;LOCK TERMS&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"LOCK TERMS define the conditions under which loans can be locked, affecting MANDATORY LOCK-IN COMMITMENT."</data>
  <data key="d6">chunk-8c6c6dd97681ba9caa6c83d8ddf9ec59</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;UPFRONT FEE&quot;" target="&quot;EXTENDED LOCK IN COMMITMENTS&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"An UPFRONT FEE may be required for EXTENDED LOCK IN COMMITMENTS exceeding 90 days."</data>
  <data key="d6">chunk-8c6c6dd97681ba9caa6c83d8ddf9ec59</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;LOAN DELIVERY&quot;" target="&quot;BEST EFFORTS DELIVERY&quot;">
  <data key="d4">8.0</data>
