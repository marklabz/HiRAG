  <data key="d4">7.0</data>
  <data key="d5">"Minimum size restrictions are established through restrictive agreements to ensure compliance with zoning and community standards."</data>
  <data key="d6">chunk-e4823f54b9e7afeaec0c69de7747fd4e</data>
  <data key="d7">1</data>
</edge>
