<node id="&quot;MORTGAGE LOAN TRANSACTION&quot;">
  <data key="d0">("EVENT"</data>
  <data key="d1">"Mortgage Loan Transaction refers to the process and sequence of events involved in the buying and selling of a Mortgage Loan."</data>
  <data key="d2">chunk-b2fbf5161dc5c6670b7fd7548d822a73</data>
  <data key="d3">[{"level": 0, "cluster": 5}, {"level": 1, "cluster": 84}, {"level": 2, "cluster": 426}]</data>
