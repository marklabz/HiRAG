  <data key="d6">chunk-b722d926669aa7676c36ecbb75a4a233</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;RATE SHEET PRICING&quot;" target="&quot;RATE QUOTES&quot;">
  <data key="d4">8.0</data>
