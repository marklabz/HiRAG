  <data key="d6"></data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;BORROWER&quot;" target="&quot;FIRST TIME HOME BUYER&quot;">
  <data key="d4">8.5</data>
  <data key="d5">"First Time Home Buyer refers to individuals or families purchasing their first home, often subject to additional guidelines or restrictions in loan programs."</data>
