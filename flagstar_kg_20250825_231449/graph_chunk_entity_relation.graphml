  <data key="d4">7.0</data>
  <data key="d5">"The Community Bank/Credit Union program includes specific early loan payoff fees, establishing a financial relationship between them."</data>
  <data key="d6">chunk-bf2d9f6b5b471373ca78f75c11d02725</data>
  <data key="d7">1</data>
</edge>
