  <data key="d3">[{"level": 0, "cluster": 10}, {"level": 1, "cluster": 131}, {"level": 2, "cluster": 558}]</data>
</node>
<node id="&quot;TITLE FEES&quot;">
  <data key="d0">"PRODUCT"</data>
  <data key="d1">"Title Fees are charges associated with closing costs in real estate transactions, necessary for securing titles in HELOCs."&lt;SEP&gt;"Title Fees are charges imposed by settlement agents for title work required in the closing process, even if no title work is needed for a specific transaction."&lt;SEP&gt;"Title Fees refer to the costs associated with the preparation and issuance of title insurance documents necessary for the closing."</data>
  <data key="d2">chunk-4a8254e91bb361353c2efd5fd41f17e0&lt;SEP&gt;chunk-a39b79f6d626310fd702e88ad4acda2b&lt;SEP&gt;chunk-a6589af60d5cd7b7c6c55232071772b8</data>
