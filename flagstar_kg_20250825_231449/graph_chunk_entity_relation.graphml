<node id="&quot;REVOCABLE LIVING TRUST&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"A Revocable Living Trust is a legal entity that allows a grantor to retain control over their assets during their lifetime, which can affect title insurance eligibility."</data>
  <data key="d2">chunk-9351b24bca225d97ff2d45b46310a878</data>
