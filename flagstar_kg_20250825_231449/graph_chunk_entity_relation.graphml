</node>
<node id="&quot;STANDARD EXCEPTIONS&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Standard exceptions are the common exclusions outlined in title insurance policies that typically apply to all transactions."</data>
  <data key="d2">chunk-9351b24bca225d97ff2d45b46310a878</data>
  <data key="d3">[{"level": 0, "cluster": 23}, {"level": 1, "cluster": 228}]</data>
