  <data key="d4">8.0</data>
  <data key="d5">"CONVENTIONAL ADMINISTRATIVE FEES consist of various FEE NAMES that contribute to the overall fee structure for both conforming and non-conforming loans."</data>
  <data key="d6">chunk-da6a7f245e88177bac6b85d5f808ebd3</data>
  <data key="d7">1</data>
</edge>
