  <data key="d4">9.0</data>
  <data key="d5">"The Funding Date is critical in determining when Early Loan Payoff Fees apply to borrowers based on their payment actions."</data>
  <data key="d6">chunk-662a2c10d200da7291e0212d33749544</data>
  <data key="d7">1</data>
</edge>
