  <data key="d4">7.0</data>
  <data key="d5">"A COMMITMENT can be considered expired if the LOCK COMMITMENT EXPIRED condition is met, requiring a relock."</data>
  <data key="d6">chunk-fff6b81ef8a66ecc49bb49ef81869a5f</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;CURRENT MARKET PRICE&quot;" target="&quot;NEGATIVE ADJUSTMENT&quot;">
  <data key="d4">7.0</data>
