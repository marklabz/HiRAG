  <data key="d2">chunk-783c4782c02cd021bcdf3bdbcc5f3466</data>
  <data key="d3">[{"level": 0, "cluster": 2}, {"level": 1, "cluster": 10}]</data>
</node>
<node id="&quot;NEGATIVE AMORTIZATION&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Negative Amortization is a concept referring to a loan condition where the loan balance increases due to payments not covering the interest charged."</data>
  <data key="d2">chunk-783c4782c02cd021bcdf3bdbcc5f3466</data>
  <data key="d3">[{"level": 0, "cluster": 2}, {"level": 1, "cluster": 11}]</data>
</node>
<node id="&quot;INTEREST RATE ADJUSTMENT&quot;">
  <data key="d0">"EVENT"</data>
