  <data key="d4">6.0</data>
  <data key="d5">"This fee is charged when a loan is underwritten and then withdrawn, specifically for appraisals ordered through Loantrac."</data>
  <data key="d6">chunk-fe4b9e8302b8de2d8d692106e4e284ae</data>
  <data key="d7">1</data>
