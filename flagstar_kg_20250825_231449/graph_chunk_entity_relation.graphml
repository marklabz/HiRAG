  <data key="d0">"ORGANIZATION"</data>
  <data key="d1">"Consolidated Analytics is an organization responsible for conducting collateral evaluations for Standalone HELOC transactions, ensuring that property values are assessed accurately."&lt;SEP&gt;"Consolidated Analytics is the organization responsible for conducting collateral evaluations for Standalone HELOC transactions."</data>
