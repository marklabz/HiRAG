  <data key="d6">chunk-cfcbc01d9662fc8a4930eb1a9dd46384</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;EMAIL&quot;" target="&quot;CUST SVC&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"Customer service offers contact through email to facilitate communication with borrowers."</data>
  <data key="d6">chunk-cfcbc01d9662fc8a4930eb1a9dd46384</data>
  <data key="d7">1</data>
</edge>
