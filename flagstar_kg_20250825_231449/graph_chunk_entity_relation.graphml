  <data key="d6">chunk-a40aeeabaca2a4a97b1dd8ad35ab142e</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;MORTGAGE LOAN&quot;" target="&quot;FEDERAL HOUSING ADMINISTRATION (FHA)&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"FHA insures Mortgage Loans to facilitate home ownership for borrowers who may not qualify through traditional means."</data>
  <data key="d6">chunk-a40aeeabaca2a4a97b1dd8ad35ab142e</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;MORTGAGE LOAN&quot;" target="&quot;DEPARTMENT OF VETERANS AFFAIRS (VA)&quot;">
  <data key="d4">9.0</data>
  <data key="d5">"The VA offers guarantees on Mortgage Loans for eligible veterans, thus promoting accessibility to home financing."</data>
  <data key="d6">chunk-a40aeeabaca2a4a97b1dd8ad35ab142e</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;MORTGAGE LOAN&quot;" target="&quot;TRUTH IN LENDING ACT AND REGULATION Z (TILA)&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"TILA works to ensure clear disclosure of terms and costs associated with Mortgage Loans to borrowers."</data>
  <data key="d6">chunk-a40aeeabaca2a4a97b1dd8ad35ab142e</data>
  <data key="d7">1</data>
</edge>
