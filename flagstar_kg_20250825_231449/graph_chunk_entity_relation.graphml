  <data key="d6">chunk-a6589af60d5cd7b7c6c55232071772b8</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;CLOSING DISCLOSURE&quot;" target="&quot;CD/ALTA STATEMENT&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"The CD/ALTA Statement supports the fees entered on the Closing Disclosure, detailing transaction specifics."</data>
  <data key="d6">chunk-a6589af60d5cd7b7c6c55232071772b8</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;CLOSING DISCLOSURE&quot;" target="&quot;PRINT DATE&quot;">
  <data key="d4">6.0</data>
