  <data key="d0">"NORMAL_ENTITY"</data>
  <data key="d1">"Best Efforts Lock-In Commitment is a loan locking term that offers flexibility, contingent upon the loan closing successfully."</data>
  <data key="d2">chunk-8c6c6dd97681ba9caa6c83d8ddf9ec59</data>
</node>
<node id="&quot;LOCK TERMS&quot;">
  <data key="d0">"NORMAL_ENTITY"</data>
