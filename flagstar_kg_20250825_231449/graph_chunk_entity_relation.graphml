  <data key="d4">18.0</data>
  <data key="d5">"The Loan Application Process is directly tied to the successful acquisition of a Loan, outlining necessary procedures and documentation."&lt;SEP&gt;"The Loan Application Process is essential for obtaining a Loan, dictating the procedures to follow for approval."</data>
  <data key="d6">chunk-f18d8da3052c73dc1f9fa6e9aef1a14e</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;LOAN&quot;" target="&quot;BUSINESS DOCUMENT REQUIREMENTS&quot;">
  <data key="d4">9.0</data>
