  <data key="d2">chunk-889bb036e55402548e1f5e0fcb109226</data>
  <data key="d3">[{"level": 0, "cluster": 4}, {"level": 1, "cluster": 17}]</data>
</node>
<node id="&quot;LOANTRAC&quot;">
  <data key="d0">"TECHNOLOGY"</data>
  <data key="d1">"Loantrac is a service or technology platform related to the management of loan documentation and processes, mentioned in connection with Flagstar's WBCD."&lt;SEP&gt;"Loantrac is a system used to manage mortgage loan processes, including tracking rates and statuses of loans."</data>
