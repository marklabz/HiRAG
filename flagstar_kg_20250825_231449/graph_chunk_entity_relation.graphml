  <data key="d4">7.0</data>
  <data key="d5">"Survey exceptions are critical for the title insurance company to assess risks and ensure no unpermitted encroachments exist."</data>
  <data key="d6">chunk-e4823f54b9e7afeaec0c69de7747fd4e</data>
  <data key="d7">1</data>
</edge>
