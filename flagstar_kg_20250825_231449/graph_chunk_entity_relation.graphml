  <data key="d6">chunk-8c6c6dd97681ba9caa6c83d8ddf9ec59</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;RATE SHEET PRICING&quot;" target="&quot;PRICE A LOAN&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"RATE SHEET PRICING is utilized when using the PRICE A LOAN feature on the website."</data>
  <data key="d6">chunk-8c6c6dd97681ba9caa6c83d8ddf9ec59</data>
  <data key="d7">1</data>
</edge>
