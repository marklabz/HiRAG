</edge>
<edge source="&quot;MORTGAGE LOAN&quot;" target="&quot;APPLICABLE LAW&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"The origination of Mortgage Loans must comply with Applicable Law, including various federal and state regulations."</data>
  <data key="d6">chunk-a40aeeabaca2a4a97b1dd8ad35ab142e</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;MORTGAGE LOAN&quot;" target="&quot;GOVERNMENT NATIONAL MORTGAGE ASSOCIATION&quot;">
  <data key="d4">8.0</data>
