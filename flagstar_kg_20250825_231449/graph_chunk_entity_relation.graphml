<node id="&quot;CONVENTIONAL LOANS&quot;">
  <data key="d0">"PRODUCT"</data>
  <data key="d1">"Conventional Loans are mortgage loans that are not insured or guaranteed by the government, often having stricter eligibility criteria."</data>
  <data key="d2">chunk-889bb036e55402548e1f5e0fcb109226</data>
