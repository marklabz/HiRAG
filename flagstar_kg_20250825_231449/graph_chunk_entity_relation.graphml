</edge>
<edge source="&quot;BORROWER&quot;" target="&quot;PREPAIDS/ESCROWS&quot;">
  <data key="d4">7.0</data>
  <data key="d5">"The Borrower is responsible for providing Prepaids/Escrows as part of their personal funds for the mortgage."</data>
  <data key="d6">chunk-fd698c420bb978f364630c455d2abf4a</data>
  <data key="d7">1</data>
</edge>
