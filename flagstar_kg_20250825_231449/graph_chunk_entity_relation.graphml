  <data key="d4">8.0</data>
  <data key="d5">"When a loan is underwritten and denied, an adverse action letter must be issued to the applicant."</data>
  <data key="d6">chunk-fe4b9e8302b8de2d8d692106e4e284ae</data>
  <data key="d7">1</data>
</edge>
