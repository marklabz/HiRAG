  <data key="d6">chunk-b2fbf5161dc5c6670b7fd7548d822a73</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;CLOSING DISCLOSURE&quot;" target="&quot;CO-OWNER&quot;">
  <data key="d4">8.0</data>
  <data key="d5">"Co-owners are allowed to sign key documents including the Closing Disclosure, establishing a legal connection in the closing process."</data>
  <data key="d6">chunk-4f5452ea8c1afd9252c54573e518675e</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;CLOSING DISCLOSURE&quot;" target="&quot;CO-SIGNER&quot;">
  <data key="d4">8.0</data>
