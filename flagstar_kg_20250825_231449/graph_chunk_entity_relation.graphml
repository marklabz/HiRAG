  <data key="d6">chunk-29e2bb5014fcbf1d6e95d3ac5b1702bc</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;INTEREST RATE ADJUSTMENT CAPS&quot;" target="&quot;INITIAL RATE&quot;">
  <data key="d4">17.0</data>
  <data key="d5">"INITIAL RATE is impacted by the INTEREST RATE ADJUSTMENT CAPS, affecting the overall loan payment structure."&lt;SEP&gt;"The Initial Rate is constrained by the Interest Rate Adjustment Caps outlined in the loan agreement."</data>
  <data key="d6">chunk-49f8738c76594c2ed9866d0e86818ca8</data>
  <data key="d7">1</data>
</edge>
<edge source="&quot;INTEREST RATE ADJUSTMENT CAPS&quot;" target="&quot;LIFETIME CAP&quot;">
  <data key="d4">26.0</data>
  <data key="d5">"LIFETIME CAP represents the maximum limit of adjustment outlined in the INTEREST RATE ADJUSTMENT CAPS."&lt;SEP&gt;"LIFETIME CAP specifies the maximum adjustments over the life of the loan as indicated by the INTEREST RATE ADJUSTMENT CAPS."&lt;SEP&gt;"Lifetime Cap represents the ultimate cap on the total interest rate adjustments defined by the Interest Rate Adjustment Caps."</data>
  <data key="d6">chunk-49f8738c76594c2ed9866d0e86818ca8</data>
  <data key="d7">1</data>
</edge>
