  <data key="d4">7.0</data>
  <data key="d5">"Loans that are underwritten and subsequently either withdrawn or denied require payment of the Appraisal Release Fee, indicating a financial connection in loan processing actions."</data>
  <data key="d6">chunk-bf2d9f6b5b471373ca78f75c11d02725</data>
  <data key="d7">1</data>
</edge>
