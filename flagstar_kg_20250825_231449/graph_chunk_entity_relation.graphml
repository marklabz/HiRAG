<node id="&quot;HOMEREADY-HOMESTYLE HIGH BALANCE 10-YEAR FIXED&quot;">
  <data key="d0">"PRODUCT"</data>
  <data key="d1">"HomeReady-HomeStyle High Balance 10-Year Fixed is a loan option that features high-balance financing with a fixed rate intended for repayment within ten years, suitable for aggressive pay-down strategies."</data>
  <data key="d2">chunk-e4c4e62420861ecd803f90fd967a2c1c</data>
  <data key="d3">[{"level": 0, "cluster": 4}, {"level": 1, "cluster": 68}, {"level": 2, "cluster": 371}]</data>
