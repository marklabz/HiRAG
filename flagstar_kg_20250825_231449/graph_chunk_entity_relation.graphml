  <data key="d4">8.0</data>
  <data key="d5">"Document #4124 provides guidelines regarding worse case pricing in loan applications, establishing a connection with pricing policies."</data>
  <data key="d6">chunk-1afd5d25f6f318da0cbe2e55f0a46af0</data>
  <data key="d7">1</data>
</edge>
