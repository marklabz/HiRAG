  <data key="d2">chunk-ca3069902295dcf5b2b505753d7623f3</data>
  <data key="d3">[{"level": 0, "cluster": 5}, {"level": 1, "cluster": 89}, {"level": 2, "cluster": 445}]</data>
</node>
<node id="&quot;THIRD PARTY ORIGINATIONS&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"Third Party Originations refer to loans that are initiated by non-lending entities, which may face specific restrictions in financing."</data>
  <data key="d2">chunk-ca3069902295dcf5b2b505753d7623f3</data>
</node>
<node id="&quot;TOLERANCES&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Tolerances refer to the acceptable range of variation in property valuations or financial assessments as determined by lenders."</data>
  <data key="d2">chunk-ca3069902295dcf5b2b505753d7623f3</data>
  <data key="d3">[{"level": 0, "cluster": 3}, {"level": 1, "cluster": 60}, {"level": 2, "cluster": 340}]</data>
</node>
<node id="&quot;SIGNATURES&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"Signatures are required consent forms that validate various documents within the loan process, ensuring legal compliance."</data>
  <data key="d2">chunk-ca3069902295dcf5b2b505753d7623f3</data>
</node>
<node id="&quot;CONFIRMATION OF TRANSFER OF FUNDS&quot;">
  <data key="d0">"DOCUMENT"</data>
  <data key="d1">"Confirmation of Transfer of Funds serves as proof that money has been moved from one account to another, essential in real estate transactions."</data>
  <data key="d2">chunk-ca3069902295dcf5b2b505753d7623f3</data>
</node>
<node id="&quot;EVIDENCE OF TRANSFER OF FUNDS&quot;">
  <data key="d0">"DOCUMENT"</data>
  <data key="d1">"Evidence of Transfer of Funds refers to bank statements or cancelled checks that validate the movement of money, which is necessary for loan processing."</data>
  <data key="d2">chunk-ca3069902295dcf5b2b505753d7623f3</data>
  <data key="d3">[{"level": 0, "cluster": 1}, {"level": 1, "cluster": 36}, {"level": 2, "cluster": 267}]</data>
</node>
<node id="&quot;SEISMIC STUDY AREA&quot;">
  <data key="d0">"LOCATION"</data>
  <data key="d1">"Seismic Study Area denotes regions assessed for earthquake risk, which are considered in the eligibility for property financing."</data>
  <data key="d2">chunk-ca3069902295dcf5b2b505753d7623f3</data>
  <data key="d3">[{"level": 0, "cluster": 20}, {"level": 1, "cluster": 203}, {"level": 2, "cluster": 721}]</data>
</node>
<node id="&quot;THREE BUSINESS DAY TIMING REQUIREMENT&quot;">
  <data key="d0">"REQUIREMENT"</data>
  <data key="d1">"Three Business Day Timing Requirement mandates that borrowers must receive a copy of the appraisal within this timeline to comply with lending regulations."</data>
  <data key="d2">chunk-ca3069902295dcf5b2b505753d7623f3</data>
</node>
<node id="&quot;INVESTMENT PROPERTY LOANS&quot;">
  <data key="d0">"FINANCIAL"</data>
  <data key="d1">"Investment Property Loans are specifically designed to finance properties that are not a borrower's primary residence but are intended to generate rental income."</data>
  <data key="d2">chunk-ca3069902295dcf5b2b505753d7623f3</data>
  <data key="d3">[{"level": 0, "cluster": 20}, {"level": 1, "cluster": 206}]</data>
</node>
<node id="&quot;APPRAISAL PRICING&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"Appraisal Pricing refers to the monetary valuation attributed to properties during an appraisal, essential for determining loan eligibility."</data>
  <data key="d2">chunk-ca3069902295dcf5b2b505753d7623f3</data>
  <data key="d3">[{"level": 0, "cluster": 20}, {"level": 1, "cluster": 203}, {"level": 2, "cluster": 721}]</data>
</node>
<node id="&quot;ENHANCED DESK REVIEW&quot;">
  <data key="d0">"PRODUCT"</data>
