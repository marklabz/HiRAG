  <data key="d5">"DELINQUENT CREDIT leads to COLLECTIONS as negative entries on a credit report."&lt;SEP&gt;"Delinquent credit is affected by collections that must be settled before loan closing."</data>
  <data key="d6">chunk-cb4e4bbf1091286e7015a8784c37cbc2&lt;SEP&gt;chunk-150cc6b2e7ba7007f09ed79ae5042c88</data>
  <data key="d7">1</data>
</edge>
