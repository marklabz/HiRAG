  <data key="d2">chunk-1418f5447a956615e29938e7c6f0f71a</data>
  <data key="d3">[{"level": 0, "cluster": 21}, {"level": 1, "cluster": 210}, {"level": 2, "cluster": 736}]</data>
</node>
<node id="&quot;SUBMISSION METHOD&quot;">
  <data key="d0">"CONCEPT"</data>
